def S(key: str) -> str:
    return STRINGS.get(LANG, STRINGS[LANG_FALLBACK])[key]


def recorded_lang(root: Path) -> str | None:
    """The language this kb was created in, or None for one predating the mark."""
    f = root / OVERVIEW
    if not f.is_file():
        return None
    m = LANG_RE.search(f.read_text(encoding="utf-8", errors="replace"))
    return m.group(1) if m and m.group(1) in STRINGS else None


def set_lang(root: Path) -> None:
    """Render in the kb's own language. Called once a root is known."""
    global LANG
    LANG = recorded_lang(root) or LANG_ENV or LANG_DEFAULT

# Six kinds, not more. The distinction that earns its keep: does a newer file
# REPLACE this one (state, plan) or is it edited in place (reference, recipe)?
# `decision` is separate because it is immutable — superseded, never rewritten.
# `charter` is the one thing no snapshot carries: a `state` says where the work
# stands and a `plan` says what is next, so "why this exists and what we are
# deliberately NOT building" had nowhere to live and was re-argued from scratch.
# One per kb, enforced in `add` — a second charter means two directions.
KINDS = {
    "charter": "why this stream exists, its boundaries, and what is deliberately not done",
    "state": "snapshot on a date; a later one supersedes it",
    "plan": "what is planned, in what order",
    "decision": "a choice and why it was made",
    "reference": "how something works; durable description",
    "recipe": "traps and ready-to-run verification commands",
}

NAME_RE = re.compile(r"^(\d{2,})-(.+)\.md$")
DATE_IN_NAME_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")
FM_FENCE = "---"

# Size is ADVISORY, never enforced. These files are read on demand, one at a
# time, so a long coherent reference costs nothing until someone opens it — the
# 200-line rule for always-loaded instruction files does not transfer. What does
# hurt is a single Read that eats the context window, hence two thresholds:
# SOFT = worth a look if the sections answer different questions,
# HARD = one Read is genuinely expensive, flag it in the index for the reader.
SOFT_LINES = 400
HARD_LINES = 1200
CHARS_PER_TOKEN = 3.5   # rough, Cyrillic-heavy prose

# Registry of known kb directories. Without it there is no way to answer "where
# do my notes live" short of remembering paths — every directory is an island.
# Written by whatever creates a kb, VERIFIED on read (a path that lost its
# overview is reported, not silently trusted), and repairable with --scan.
REGISTRY = Path(os.environ.get(
    "KB_REGISTRY", Path.home() / ".local/state/kb/registry.txt"))
# Pruned when scanning: never contain notes, always expensive to walk.
SCAN_SKIP = {".git", "node_modules", ".terraform", ".venv", "__pycache__",
             ".cache", ".memsearch", ".ai-context"}


# ── secret detection ────────────────────────────────────────────────────────
# Two layers, and the report always says which of them ran. Built-in patterns
# work everywhere with no install; an external scanner, when one happens to be
# present, brings a far larger ruleset. Silence about which layer ran would be
# worse than no check at all — it reads as "clean" when it may mean "unchecked".
#
# Only shapes with an unmistakable prefix or header are listed. Generic
# `password=`-style matches and entropy heuristics are deliberately absent:
# notes about infrastructure are full of paths, pod names and config values that
# look exactly as random as a token. A report that is mostly false positives
# stops being read within days — the same lesson `verify` was built on.
#
# What none of this catches: a short generic password sitting in a sentence.
# The gitleaks author says as much about `MyServiceToken="secret123"`. This
# lowers risk; it does not replace not writing secrets down.
SECRET_PATTERNS = [
    ("AWS access key",      re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("GitHub token",        re.compile(r"\b(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}\b")),
    ("GitHub fine-grained", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}\b")),
    ("Slack token",         re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}")),
    ("private key",         re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("JWT",                 re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.")),
    ("password in a URL",   re.compile(r"://[^/\s:@]+:[^/\s@]{3,}@")),
    ("Google API key",      re.compile(r"\bAIza[A-Za-z0-9_-]{35}\b")),
    ("Stripe key",          re.compile(r"\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\b")),
    ("OpenAI-family key",  re.compile(r"\bsk-(?:or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}")),
    ("Atlassian token",    re.compile(r"\bat-[A-Za-z0-9]{30,}")),
    ("SQL password",       re.compile(r"IDENTIFIED\s+BY\s+['\"][^'\"]{6,}['\"]", re.I)),
]

# Secrets with no distinctive prefix -- an AWS secret access key is forty
# characters of base64 and nothing else. Shape alone would fire on every hash
# in the notes, so these require the well-known variable name AND the value
# shape together. That pairing is precise: `aws_secret_access_key = <40 base64>`
# has no innocent reading, while a bare forty-character token has many.
#
# Found by testing against a real credential pair: the access key id was caught
# and the secret sitting beside it was not. They usually appear together, so one
# hit flags both -- but "usually" is not a control.
SECRET_ASSIGNMENTS = [
    ("AWS secret access key",
     re.compile(r"""aws_secret_access_key\s*[=:]\s*['"]?[A-Za-z0-9/+=]{40}""", re.I)),
    ("secret in an assignment",
     re.compile(r"""\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token"""
                r"""|client[_-]?secret|password|passwd)\s*[=:]\s*['"][^'"]{8,}['"]""",
                re.I)),
    # Bare `key:`/`token:` with a long unbroken value. Measured on both live note
    # directories before adding: zero matches, so the shape does not collide with
    # ordinary YAML-ish prose. Requires the value to run to end of line, which is
    # what separates a pasted token from a sentence.
    ("token in a bare assignment",
     re.compile(r"""\b(?:key|token|secret)\s*[:=]\s*['"]?[A-Za-z0-9/+=_-]{20,}['"]?\s*$""",
                re.I)),
]

EXTERNAL_SCANNERS = [
    ("gitleaks",       ["gitleaks", "detect", "--no-git", "--no-banner", "-s"]),
    ("trufflehog",     ["trufflehog", "filesystem", "--no-update", "--fail"]),
    ("detect-secrets", ["detect-secrets", "scan"]),
]


def scan_line(line: str) -> list[str]:
    """Named shapes only — no entropy heuristic.

    An entropy pass was written and then removed: on two real note directories it
    produced four findings, all four false — a file path, a config value, a
    Kubernetes pod name and another path. Identifiers and paths are long and
    look random, and no threshold separated them from a token. That is the exact
    ratio this project refuses to ship, so layer 1 stays precise and narrow, and
    entropy is left to the external scanners in layer 2, which tune it properly.
    """
    return ([name for name, rx in SECRET_PATTERNS if rx.search(line)]
            + [name for name, rx in SECRET_ASSIGNMENTS if rx.search(line)])


def external_scanner() -> tuple[str, list[str]] | None:
    for name, cmd in EXTERNAL_SCANNERS:
        if shutil.which(cmd[0]):
            return name, cmd
    return None


def find_secrets(root: Path, notes: list) -> tuple[list[str], str]:
    """Returns (findings, one line describing what was actually checked)."""
    found = []
    for n in notes:
        for i, line in enumerate(n.text.split("\n"), 1):
            for what in scan_line(line):
                found.append(f"{n.name}:{i}: looks like {what}")

    ext = external_scanner()
    coverage = "built-in patterns only"
    if ext:
        name, cmd = ext
        try:
            res = subprocess.run(cmd + [str(root)], capture_output=True,
                                 text=True, timeout=120)
            coverage = f"built-in patterns + {name}"
            if res.returncode != 0 and (res.stdout.strip() or res.stderr.strip()):
                found.append(f"{name} reported findings — run it directly to see them:"
                             f"  {' '.join(cmd)} {root}")
        except (OSError, subprocess.SubprocessError):
            coverage = f"built-in patterns only ({name} failed to run)"
    return found, coverage


def die(msg: str) -> None:
    print(f"kb: {msg}", file=sys.stderr)
    sys.exit(1)


@dataclass
class Note:
    path: Path
    num: int
    slug: str
    kind: str
    title: str
    updated: str
    supersedes: str
    has_fm: bool
    # The file as it was read. `load_notes` has it in hand already, and without
    # it every consumer opened the same file again: the link check, the
    # unanswered-section check and the secret scan read each note three times
    # over inside one `check`, and `brief` -- which runs check and verify -- paid
    # for all of it twice more. A note is rewritten by `add` and `adopt`, both of
    # which reload afterwards, so nothing here reads a stale copy.
    text: str = ""
    lines: int = 0
    chars: int = 0

    @property
    def name(self) -> str:
        return self.path.name

    @property
    def ktokens(self) -> int:
        return round(self.chars / CHARS_PER_TOKEN / 1000)

    @property
    def sort_date(self) -> str:
        """For state files the date in the NAME is the snapshot date and wins.

        `updated` may be bumped by a later typo fix without the snapshot itself
        moving, so it must not decide which snapshot is current.
        """
        m = DATE_IN_NAME_RE.search(self.name)
        return m.group(1) if m else self.updated


def find_root(explicit: str | None, *, for_init: bool = False) -> Path:
    """Wrapper: every caller gets the kb's own language set before it renders."""
    root = absolute(_find_root(explicit, for_init=for_init))
    set_lang(root)
    return root


def _find_root(explicit: str | None, *, for_init: bool = False) -> Path:
    if explicit:
        # An explicit --dir was trusted without checking, so every reading
        # command crashed with a traceback when the directory held no index --
        # which happens routinely for a path that has since been moved or
        # deleted, exactly the case `kb list` reports.
        root = Path(explicit)
        if not for_init and not (root / OVERVIEW).is_file():
            # Two different situations, and guessing between them reads as
            # nonsense: "the directory is empty" about a directory full of
            # files is simply false. Report the fact, name the fix.
            if not root.is_dir():
                die(f"no such directory: {root}")
            die(f"no {OVERVIEW} in {root} — not a kb directory. "
                f"`kb init --dir {root}` starts one; "
                "`kb list --prune` drops the entry if it moved")
        return root
    cwd = Path.cwd().resolve()
    for base in search_bases(cwd):
        for name in NOTES_DIRS:
            if (base / name / OVERVIEW).exists():
                return base / name
        if (base / OVERVIEW).exists():
            return base                 # flat layout: this dir IS the work stream
    if for_init:
        return cwd / NOTES_DIRS[0]
    names = " or ".join(f"./{n}" for n in NOTES_DIRS)
    die(f"no {OVERVIEW} in {names} or ., here or in any directory above — run "
        "`kb init` first, or pass --dir")


def dequote(value: str) -> str:
    """Drop one pair of surrounding quotes.

    The block is not YAML, but it looks like it — `---` fences and `key: value`.
    Anyone editing by hand quotes a value containing ": " because strict YAML
    demands it there, and without this the quotes would be part of the title.
    They land in the index row, which is what a reader sees before opening any
    file, and nothing in `check` looks at the first character of a title.
    """
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_front_matter(text: str) -> tuple[dict, str]:
    """Minimal front-matter reader: `key: value` lines between --- fences.

    Not YAML on purpose — no dependency, and every field here is a flat string.
    Values may contain colons (titles do), so only the FIRST colon splits.
    Surrounding quotes are dropped, so a hand-written YAML-style value works.
    """
    if not text.startswith(FM_FENCE):
        return {}, text
    lines = text.split("\n")
    end = None
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == FM_FENCE:
            end = i
            break
    if end is None:
        return {}, text
    meta = {}
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, sep, value = line.partition(":")
        if sep:
            meta[key.strip()] = dequote(value.strip())
    return meta, "\n".join(lines[end + 1:])


def guess_kind(slug: str) -> str:
    s = slug.lower()
    for needle, kind in (
        ("state", "state"), ("срез", "state"),
        ("plan", "plan"), ("todo", "plan"),
        ("trap", "recipe"), ("recipe", "recipe"), ("gotcha", "recipe"),
        ("why", "decision"), ("decision", "decision"), ("adr", "decision"),
    ):
        if needle in s:
            return kind
    return "reference"


def first_h1(body: str) -> str:
    for line in body.split("\n"):
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def load_notes(root: Path) -> list[Note]:
    notes = []
    for path in sorted(root.glob("*.md")):
        if path.name == OVERVIEW:
            continue
        m = NAME_RE.match(path.name)
        if not m:
            continue                    # not part of the numbered scheme
        num, slug = int(m.group(1)), m.group(2)
        text = path.read_text(encoding="utf-8", errors="replace")
        meta, body = parse_front_matter(text)
        dt = DATE_IN_NAME_RE.search(path.name)
        notes.append(Note(
            path=path,
            num=num,
            slug=slug,
            kind=meta.get("kind") or guess_kind(slug),
            title=meta.get("title") or first_h1(body) or slug.replace("-", " "),
            updated=meta.get("updated") or (dt.group(1) if dt else
                     date.fromtimestamp(path.stat().st_mtime).isoformat()),
            supersedes=meta.get("supersedes", ""),
            has_fm=bool(meta),
            text=text,
            lines=text.count("\n") + 1,
            chars=len(text),
        ))
    return notes


ISO_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def current_state(notes: list[Note]) -> Note | None:
    """Newest snapshot by the date in its filename — the rule, enforced.

    Dates are compared as strings, so anything that is not an ISO date sorts
    unpredictably against real ones and can win outright: a typo in `updated`
    used to promote its file to "current snapshot", the single claim the whole
    index rests on. Snapshots without a usable date are excluded from the
    contest; `check` reports them separately.
    """
    states = [n for n in notes
              if n.kind == "state" and ISO_DATE_RE.match(n.sort_date)]
    return max(states, key=lambda n: (n.sort_date, n.num)) if states else None


def render_block(notes: list[Note]) -> str:
    """Index table, sorted by number.

    Number order, not kind order: numbers already encode when a topic appeared,
    the order stays stable across edits, and a re-sync produces a small diff
    instead of shuffling every row because one file changed kind.
    """
    cur = current_state(notes)

    # A replaced note that still EXISTS keeps its own row, and unmarked the two
    # read as equals. The older row is the trap: acting on a decision that has
    # been reversed is the whole thing `supersedes:` exists to prevent, and the
    # reader who stops at that row never reaches the one that overrules it.
    by_name = {n.name: n for n in notes}
    replaces: dict[str, list[str]] = {}
    replaced_by: dict[str, str] = {}
    for n in notes:
        for ref in n.supersedes.replace(",", " ").split():
            if ref in by_name and ref != n.name:
                replaces.setdefault(n.name, []).append(f"{by_name[ref].num:02d}")
                replaced_by[ref] = f"{n.num:02d}"

    lines = [MARK_BEGIN + f" lang={LANG}" + S("block_note")]
    if cur:
        lines += ["", S("current").format(name=cur.name, date=cur.sort_date)]
    lines += ["", S("header"), "|---|---|---|---|"]
    for n in sorted(notes, key=lambda n: n.num):
        title, kind = n.title, n.kind
        if n.kind == "state" and cur and n.name != cur.name:
            title += S("superseded")
        if n.name in replaced_by:
            title += S("reversed").format(num=replaced_by[n.name])
        if n.name in replaces:
            kind += S("replaces").format(nums=", ".join(replaces[n.name]))
        # Only past the HARD threshold: marking every long-ish file would turn
        # the column into noise and stop being a signal at all.
        if n.lines > HARD_LINES:
            title += S("heavy").format(k=n.ktokens)
        lines.append(f"| {title} | `{n.name}` | {kind} | {n.updated} |")
    lines += ["", MARK_END]
    return "\n".join(lines)


def replace_block(text: str, block: str) -> str | None:
    """Swap the managed block, leaving every other byte alone. None if no markers."""
    start = text.find(MARK_BEGIN)
    end = text.find(MARK_END)
    if start == -1 or end == -1 or end < start:
        return None
    return text[:start] + block + text[end + len(MARK_END):]


def harvest_table(text: str) -> dict[str, str]:
    """Pull `filename -> description` out of a hand-written index table.

    The descriptions a human wrote ("текущее состояние, что сделано и что
    открыто") are written for a READER; an H1 is a document title and answers a
    different question. Adoption must keep the former, or it silently downgrades
    the very prose this tool promises never to touch.
    """
    out: dict[str, str] = {}
    for line in text.split("\n"):
        if not line.lstrip().startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        fname = ""
        for cell in cells:
            m = re.search(r"`?([0-9]{2,}-[^`\s|]+\.md)`?", cell)
            if m:
                fname = m.group(1)
                break
        if not fname:
            continue                    # header or separator row
        desc = next((c for c in cells
                     if c and fname not in c and set(c) - set("-: ")), "")
        if desc:
            out[fname] = desc
    return out


def linked_files(text: str) -> set[str]:
    """Filenames referenced anywhere in the overview — backticks or md links."""
    return set(re.findall(r"[`(]([0-9]{2,}-[^`)\s]+\.md)[`)]", text))


# ── commands ────────────────────────────────────────────────────────────────

def register(root: Path) -> None:
    """Remember this kb. Idempotent, best-effort — never blocks the real work."""
    try:
        path = root.resolve()
        known = read_registry()
        if path in known:
            return
        REGISTRY.parent.mkdir(parents=True, exist_ok=True)
        with REGISTRY.open("a", encoding="utf-8") as f:
            f.write(f"{path}\n")
    except OSError:
        pass


def read_registry() -> list[Path]:
    try:
        return [Path(ln.strip()) for ln in
                REGISTRY.read_text(encoding="utf-8").splitlines() if ln.strip()]
    except OSError:
        return []


def refuse_outside(root: Path) -> None:
    """kb does not touch a directory the session is not standing in.

    Writing was confined first; reading followed, because an assistant handed a
    tool that reaches anywhere will use it to go looking. Nothing here can stop
    it running `find /` on its own -- but kb refuses to be the thing that does
    it.

    Creation was confined first, which stopped a new kb appearing in $HOME and
    left the wider hole open: `kb add --dir /elsewhere/kb` still wrote into
    someone else's notes from anywhere. Reading elsewhere is harmless and useful
    -- a cron `check` across every kb -- but writing elsewhere is the same
    wander with the same silence.

    One override, and it is an environment variable rather than a flag:
    `KB_ALLOW_OUTSIDE=1`. A flag is typed in the moment and reads as part of the
    command; a variable has to be set around the whole run, which is what a cron
    line or a wrapper script does and what a session does not do by accident.
    The error message names it, so the way out is never a guess.
    """
    if os.environ.get("KB_ALLOW_OUTSIDE") == "1":
        return
    try:
        target, cwd = root.resolve(), Path.cwd().resolve()
    except OSError:
        return
    if target == cwd or cwd in target.parents:
        return
    # The notes of the stream this session is standing INSIDE. Working in a
    # subdirectory is the ordinary case, and the walk that finds the kb above
    # cwd produced a path this check then called "outside" -- the one place the
    # confinement was wrong, since nothing was reached across to. The bound is
    # the same one the walk uses: an ancestor of cwd, never a sibling.
    project = project_of(target)
    if project == cwd or project in cwd.parents:
        return
    die(f"{target} is outside {cwd}. `cd` there first. A script that must reach "
        "across directories sets KB_ALLOW_OUTSIDE=1, which says so out loud")


def refuse_bad_root(root: Path) -> None:
    """Stop before scaffolding notes somewhere that is not a work stream.

    Real incident: an assistant decided the work was machine-level, ran kb with
    cwd set to ~/.local/bin -- where the script it had just written lived -- and
    kb dutifully created a knowledge base among sixty executables. Moving it out
    by hand then cost a symlink to an `rm -rf`. Nothing in the tool objected,
    because nothing was asked to.

    The test is the containing directory, since the layout puts notes in
    `<dir>/kb`. Refusing is cheap; the fix is one `mkdir` away.
    """
    target = project_of(root)
    try:
        target = target.resolve()
    except OSError:
        return
    home = Path.home().resolve()

    # A NEW kb may only appear under the directory you are standing in. The
    # incident this closes: a session whose cwd was an empty project directory
    # created its notes in $HOME instead, because the assistant reasoned about
    # the subject and forgot the location was a decision at all. Reading and
    # writing an EXISTING kb elsewhere stays open -- that is how cron and
    # wrapper scripts use --dir, and passing a path to one is a human's choice.
    # Wanting a kb somewhere else is one `cd` away, and the cd says so out loud.
    cwd = Path.cwd().resolve()
    # Standing at the filesystem root would otherwise authorise every path on
    # the machine, since everything is "under" it.
    if cwd == Path("/"):
        die("cwd is / — that authorises nothing. `cd` to the directory the "
            "notes are about")
    if not (target == cwd or cwd in target.parents):
        die(f"{target} is outside {cwd} — a new kb is created only under the "
            "directory you are in. `cd` there first, or point --dir at a kb "
            "that already exists")

    if target == home or target.parent == home:
        die(f"{target} sits directly in your home directory, which is not a "
            "work stream — notes there have nothing to be about. Make a "
            "directory for the subject first")

    path_dirs = {Path(d).resolve() for d in
                 os.environ.get("PATH", "").split(os.pathsep) if d}
    if target in path_dirs:
        die(f"{target} is on your PATH — it holds programs, not a work stream. "
            "Notes about the machine belong in a directory of their own")

    system = {Path(d) for d in ("/", "/etc", "/usr", "/var", "/opt", "/tmp",
                                "/bin", "/sbin", "/lib", "/root")}
    if target in {d.resolve() for d in system if d.exists()}:
        die(f"{target} is a system directory, not a work stream — "
            "make a directory for the subject first")


def find_git_dir(start: Path) -> Path | None:
    """The `.git` directory governing `start`, or None.

    Directory only: a `.git` FILE is a worktree or submodule pointer, and the
    exclude file it points at is not where anyone looking for it would look.
    Treating that case as "no repository" costs an advisory, never correctness.
    """
    p = start.resolve()
    while p != p.parent:
        if (p / ".git").is_dir():
            return p / ".git"
        p = p.parent
    return None


def git_state(root: Path) -> str | None:
    """Are these notes versioned, deliberately local, or undecided?

    Asked of git rather than stored, because a stored answer is a second copy of
    a fact git already owns and the two part company the first time someone
    edits `.gitignore`. Three answers, and the third is the one worth a question:

      versioned  the overview is tracked — the notes ship with the repository
      local      not tracked and matched by an ignore rule — a decision was made
      undecided  not tracked, not ignored — nobody has chosen yet

    None means the question does not arise: no repository, or no git binary.
    """
    if find_git_dir(root) is None:
        return None
    overview = str((root / OVERVIEW).resolve())
    # Both commands run IN the notes directory, not above it. `root.parent` was
    # the same place for the nested layout and one directory too high for the
    # flat one: a stream that is itself the repository root put git outside the
    # work tree, both calls exited 128, and committed notes were reported as
    # "nobody has chosen yet". `find_git_dir(root)` already proved root is
    # inside a repository, so root is always a safe cwd.
    try:
        tracked = subprocess.run(
            ["git", "ls-files", "--error-unmatch", "--", overview],
            cwd=root, capture_output=True, timeout=10)
        if tracked.returncode == 0:
            return "versioned"
        ignored = subprocess.run(
            ["git", "check-ignore", "-q", "--", str(root.resolve())],
            cwd=root, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return "local" if ignored.returncode == 0 else "undecided"


def is_stream(d: Path) -> bool:
    """Does this directory belong to another kb?

    Both layouts count. `<dir>/kb/00-overview.md` is the usual one and the one
    that matters here: the nested stream is the project directory, not the `kb`
    inside it, so testing only for a loose overview pruned the notes and left
    the entry point beside them still reading as the parent's work.
    """
    return ((d / OVERVIEW).is_file()
            or any((d / n / OVERVIEW).is_file() for n in NOTES_DIRS))


def git_ignored_children(stream: Path) -> set[Path]:
    """Directories directly under `stream` that git is told to ignore.

    One call, not one per directory: `check-ignore --stdin` takes the whole
    list. Empty when there is no repository or no git, which leaves the caller
    behaving exactly as it did before -- most work streams here are not
    repositories, and a check that cannot run must not change its answer.
    """
    try:
        kids = [d for d in stream.iterdir() if d.is_dir()]
    except OSError:
        return set()
    if not kids or find_git_dir(stream) is None:
        return set()
    try:
        res = subprocess.run(
            ["git", "check-ignore", "--stdin"], cwd=stream, timeout=10,
            input="\n".join(str(d) for d in kids), capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError):
        return set()
    out = set()
    for line in res.stdout.splitlines():
        try:
            out.add(Path(line.strip()).resolve())
        except OSError:
            pass
    return out


def git_ignores(path: Path) -> bool:
    """Would git leave this path out of a commit? False when git cannot say."""
    try:
        return subprocess.run(
            ["git", "check-ignore", "-q", "--", str(path.resolve())],
            cwd=path.parent, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def allow_existing() -> bool:
    """The human said this directory is for the notes after all."""
    return os.environ.get("KB_ALLOW_EXISTING") == "1"


def refuse_existing(root: Path) -> None:
    """Never scaffold into a directory somebody else made.

    `kb` is an ordinary name and a project may already have one: source, a
    placeholder, a mount. The old test was "is there an overview here" and the
    answer for such a directory is no, so the scaffold went in beside whatever
    was there -- measured on a directory holding two source files, which then
    held two source files and an index. Nothing was overwritten and that is not
    the point: the directory was somebody's, and kb took it without asking.

    Empty counts as taken. An empty directory somebody made is a placeholder for
    the thing they are about to put in it, and "it was empty" is not consent.
    """
    # Before anything else, and before the override: `--dir` pointing at a FILE
    # reached `iterdir()` and ended in a NotADirectoryError traceback, and with
    # KB_ALLOW_EXISTING=1 it would reach `mkdir` and fail there instead. A wrong
    # path is an ordinary typo and deserves a sentence, not a stack.
    if root.exists() and not root.is_dir():
        die(f"{root} is a file, not a directory — --dir names the directory the "
            "notes live in")
    if not root.exists() or allow_existing():
        return
    if (root / OVERVIEW).is_file():
        return                          # already a kb; this is not scaffolding
    entries = [e.name for e in root.iterdir() if not e.name.startswith(".")]
    held = f"holds {len(entries)} file(s)" if entries else "is empty"
    other = NOTES_DIRS[1] if root.name == NOTES_DIRS[0] else f"{root.name}-notes"
    # Stated, not recommended. The first wording opened with "Put the notes in
    # ./.kb instead", which is an imperative, and it was carried out twice
    # without anyone being asked -- the tool's own words beat the skill's rule
    # to ask, because they arrive closer to the moment of acting. A tool that
    # cannot ask must at least not answer.
    options = [
        (f"./{other}", "a name kb also searches, so nothing needs --dir "
                       "afterwards"),
        ("this directory", "KB_ALLOW_EXISTING=1, if it is for the notes after "
                           "all"),
        ("somewhere else", "--dir <path>, and every later command needs it too"),
    ]
    if any(e.endswith(".md") for e in entries):
        options.append(("`kb adopt`", "if the files in here are already notes; "
                                      "it previews before it writes"))
    lines = [f"{root} exists, {held}, and has no {OVERVIEW} — it is not a notes "
             "directory, and kb does not write into one it did not make.",
             "  This is a decision for the person, not for kb. The options:"]
    # Padded to a column instead of by hand: the hand-spaced version lined up
    # for one value of `other` and for no other, and this text is quoted in the
    # documentation, where a ragged column reads as a defect in the tool.
    lines += [f"    {name:<16} {why}" for name, why in options]
    lines.append("  Ask which, then re-run. kb has no preference between them.")
    die("\n".join(lines))


def write_skeleton(root: Path, title: str | None) -> Path:
    # Resolved here and not only in the callers' wrapper: scaffolding happens
    # inside `_ensure_root`, which returns before that wrapper runs, and the
    # project name this function derives comes from the parent.
    root = absolute(root)
    refuse_bad_root(root)
    refuse_existing(root)
    root.mkdir(parents=True, exist_ok=True)
    overview = root / OVERVIEW
    overview.write_text(S("skeleton").format(
        title=title or (project_of(root).name if is_nested(root) else root.name),
        today=date.today().isoformat(),
        block=render_block([]),
    ), encoding="utf-8")
    register(root)
    # Asked once, and only here: after this the directory exists, so the branch
    # is never entered again and there is nothing to remember. Left undecided the
    # default decides for you -- `git add -A` sweeps the notes into a shared
    # repository, which is right for a team and wrong for a scratch stream, and
    # either way nobody chose it.
    if git_state(root) == "undecided":
        # A question, worded as one. As a "note:" it read as information and
        # two sessions running applied an answer given earlier for a different
        # directory instead of asking. Nothing here can force the asking; what
        # it can do is stop sounding like something already settled.
        print(f"UNANSWERED: {root} is in a git repository and nothing has been "
              "decided about it.\n"
              "  Left alone, `git add -A` commits the notes — a default nobody "
              "chose.\n"
              "  Ask the person which, then act: commit them to share, or "
              "`kb local` to keep them on this machine.", file=sys.stderr)
    # Prose asking for this would not fire -- measured on this tool's own notes,
    # where four rewrites of an instruction produced four different failures. A
    # line in the output that the caller already reads does.
    project = project_of(root)
    if not (project / ROUTE_FILE).exists():
        print(f"note: nothing at {project / ROUTE_FILE} points at these notes, so "
              "only someone\n  who already knows they exist will ever read them. "
              "`kb route` writes it.", file=sys.stderr)
    return overview


def ensure_root(args) -> Path:
    """Wrapper: see `find_root`. Scaffolding happens inside, in `LANG_ENV`'s
    language, and reading the mark back afterwards is what makes the choice
    stick for every command that follows."""
    root = absolute(_ensure_root(args))
    set_lang(root)
    return root


def _ensure_root(args) -> Path:
    """Root to WRITE into. Creates ./kb when the directory has no notes yet.

    Never falls back to the current directory: notes loose in a project root is
    the mess this tool exists to prevent, so an empty directory gets `kb/` made
    for it rather than being written into directly.
    """
    if args.dir:
        root = Path(args.dir)
        refuse_outside(root)
        if (root / OVERVIEW).exists():
            return root
        # An explicit --dir with no notes in it is the same situation as an
        # empty cwd and must behave the same: scaffold. It used to be returned
        # unexamined, so the note was written into a directory that did not
        # exist and `kb add` ended in a traceback.
        print(f"created {write_skeleton(root, None)}")
        return root
    cwd = Path.cwd().resolve()
    # The same walk the reading side does. A save from a subdirectory belongs to
    # the stream around it; creating a second kb there would split the notes in
    # two, which is the thing this tool exists to stop.
    for base in search_bases(cwd):
        for name in NOTES_DIRS:
            if (base / name / OVERVIEW).exists():
                return base / name
    if (cwd / OVERVIEW).exists():
        die(f"notes are loose in this directory instead of {NOTES_DIRS[0]}/.\n"
            "  Run `kb adopt` first — it previews the move, then `--apply`.\n"
            f"  Creating {NOTES_DIRS[0]}/ now would split the notes across two "
            "places.")
    # No silent fallback to the second name. Choosing it is a decision about
    # somebody else's directory, and the tool making it quietly is the failure
    # this whole guard exists to stop -- `write_skeleton` refuses and names the
    # alternative, the human answers, the caller passes `--dir`.
    root = cwd / NOTES_DIRS[0]
    print(f"created {write_skeleton(root, None)}")
    return root


def cmd_init(args) -> int:
    root = Path(args.dir) if args.dir else Path.cwd() / NOTES_DIRS[0]
    if (root / OVERVIEW).exists():
        die(f"{root / OVERVIEW} already exists — nothing to do")
    if (Path.cwd() / OVERVIEW).exists() and not args.dir:
        die(f"this directory already has a loose {OVERVIEW} — run `kb adopt` "
            "to move the existing notes into kb/ instead of starting a second set")
    print(f"created {write_skeleton(root, args.title)}")
    print('next: kb add <slug> --kind <kind> --title "<what the reader finds>"')
    return 0


def cmd_add(args) -> int:
    root = ensure_root(args)
    if args.kind not in KINDS:
        die(f"unknown --kind {args.kind!r} (known: {', '.join(KINDS)})")
    notes = load_notes(root)
    # One direction per stream. A second charter does not add detail, it splits
    # the answer to "what are we building" in two, and a reader who finds the
    # wrong half has no way to tell. Unlike `state` there is no date to order
    # them by, so nothing downstream could ever pick a winner.
    if args.kind == "charter":
        existing = next((n for n in notes if n.kind == "charter"), None)
        if existing:
            die(f"{existing.name} is already the charter of this kb. Direction is "
                "edited in place, not re-declared — open it.\n"
                "  A charter that turned out wrong is reversed by a `decision` "
                "that says why, then the charter is edited to match.")
    # A `supersedes:` name with a typo disables the mechanism in silence: the
    # index skips a reference it cannot resolve, so no `⤺` ever appears, and
    # `check` reads the same name as a retired file and therefore allows links
    # to it. Asked here and nowhere later, because after the replacement the
    # file is SUPPOSED to be gone -- this is the one moment it must be present.
    if args.supersedes:
        known = {n.name for n in notes}
        gone = [r for r in args.supersedes.replace(",", " ").split()
                if r.strip() and r not in known]
        if gone:
            have = ", ".join(sorted(known)) or "no notes yet"
            die(f"--supersedes names {', '.join(gone)}, which is not in {root}.\n"
                f"  Here: {have}\n"
                "  A name that does not resolve is never reported again: the "
                "index drops the mark and `check` treats the name as retired.")
    # Gaps are never reused: a number that once pointed at a file may still be
    # referenced from a commit message, another note, or somewhere outside.
    num = max((n.num for n in notes), default=0) + 1
    slug = args.slug
    # Whitespace in a filename cannot be referenced: the link check matches a
    # run of non-space characters, so `08-two words.md` is unlinkable-to and any
    # broken reference to it stays invisible. Every shell one-liner in the docs
    # would need quoting too. Cheaper to refuse it here than to widen a regex
    # that would then match half of the surrounding prose.
    if slug != slug.strip() or any(c.isspace() for c in slug):
        die(f"whitespace in slug {slug!r} — use hyphens: "
            f"{'-'.join(slug.split())!r}")
    # A snapshot without a date in its name cannot be ordered against the others.
    if args.kind == "state" and not DATE_IN_NAME_RE.search(slug):
        slug = f"{slug}-{date.today().isoformat()}"
    path = root / f"{num:02d}-{slug}.md"
    if path.exists():
        die(f"{path} already exists")
    title = args.title or slug.replace("-", " ")
    # The title IS the index row, and that column answers "what do I need?".
    # Answered twice identically it answers nothing -- which is what three
    # snapshots taken in one day looked like: same title, same date in the
    # name, told apart only by a number that means nothing to a reader.
    # Refused here rather than reported later: at this moment the writer knows
    # what distinguishes the two, and ten notes later nobody does.
    twin = next((n for n in notes if n.title.strip() == title.strip()), None)
    if twin:
        die(f"{twin.name} already promises the reader {title!r}. The index column "
            "answers 'what do I need?' — two rows saying the same thing answer "
            "nothing.\n  Name what makes THIS one different: for a snapshot the "
            "moment it describes, for a reference the part it covers")
    fm = [FM_FENCE, f"title: {title}", f"kind: {args.kind}",
          f"updated: {date.today().isoformat()}"]
    if args.supersedes:
        fm.append(f"supersedes: {args.supersedes}")
    fm += [FM_FENCE, "", f"# {title}", ""]
    # The body, when the caller has it already. Without this the note is created
    # empty and then overwritten whole -- two round trips instead of one, and in
    # a long session a round trip costs the entire context again. Measured on a
    # real save: sixteen tool calls, of which this pair was one, against a
    # context of ~105k. It also closes the trap of writing over a file a command
    # has just created, which had to be warned about in prose instead.
    if args.body_file:
        body = (sys.stdin.read() if args.body_file == "-"
                else Path(args.body_file).read_text(encoding="utf-8"))
        # The heading is already there. A body that repeats it gives the reader
        # two `# ` lines and the index one title.
        stripped = body.lstrip()
        if stripped.startswith("# "):
            head, _, rest = stripped.partition("\n")
            given = head[2:].strip()
            body = rest.lstrip("\n")
            # Dropping somebody's heading silently would lose the one thing it
            # said. `--title` wins because it is the index row -- two titles for
            # one note is the ambiguity refused everywhere else here.
            if given != title:
                print(f"note: dropped the body's own heading {given!r}; "
                      f"the note is titled {title!r}, which is what the index "
                      "shows", file=sys.stderr)
        fm += [body.rstrip("\n"), ""]
    else:
        # A kind says when a note expires; it never said what belongs in one, so
        # the body was filled with whatever was freshest -- always the reasoning,
        # never the location. Headings make the omission visible: an empty
        # section shows, an unwritten thought does not.
        for head in S("shape").get(args.kind, []):
            fm += [f"## {head}", "", S("fill"), ""]
    path.write_text("\n".join(fm), encoding="utf-8")
    print(f"created {path}")
    if not args.no_sync:
        return cmd_sync(args)
    return 0


def route_drift(root: Path, notes: list[Note]) -> tuple[Path, str] | None:
    """The entry point's generated block and what it should say, when it differs.

    None covers three cases that are not drift: no entry point was ever written,
    it is a file kb does not manage (no markers), or it is already current.
    """
    project = project_of(root)
    target = project / ROUTE_FILE
    if not target.is_file():
        return None
    text = target.read_text(encoding="utf-8")
    new = replace_block(text, render_route_block(root, project, notes))
    if new is None or new == text:
        return None
    return target, new


def cmd_sync(args) -> int:
    root = find_root(args.dir)
    refuse_outside(root)
    overview = root / OVERVIEW
    text = overview.read_text(encoding="utf-8")
    notes = load_notes(root)
    new = replace_block(text, render_block(notes))
    if new is None:
        die(f"no managed block in {overview}\n"
            f"  add these two lines where the index table belongs, then re-run:\n"
            f"    {MARK_BEGIN} -->\n    {MARK_END}\n"
            f"  or run `kb adopt` to retrofit an existing directory")
    if new == text:
        print(f"index already current ({len(notes)} files)")
    else:
        overview.write_text(new, encoding="utf-8")
        print(f"index rewritten: {len(notes)} files")

    # The entry point carries the same derived facts as the index -- how many
    # notes, which snapshot is current -- and used to be refreshed only by an
    # explicit `route`. So `add` rebuilt the index and left the file at the
    # project root naming a superseded snapshot, with nothing reporting it: the
    # one copy of those facts that a fresh session actually reads was the one
    # allowed to rot. Only the block between the markers is touched, and only
    # when kb wrote that file in the first place.
    drift = route_drift(root, notes)
    if drift:
        target, new_text = drift
        refuse_outside(target.parent)
        target.write_text(new_text, encoding="utf-8")
        print(f"entry point refreshed: {target}")
        # Said here as well as in `route`, because after the first run this is
        # the only command that ever touches the file again. Reporting it only
        # where it was written means reporting it once, in a turn nobody
        # revisits -- which is how the budget went unmentioned for a whole file
        # that had grown past it.
        findings = route_findings(root)
        for finding in findings:
            print(f"  ⚠ {finding}")
        if findings:
            print(f"  {ENTRY_POINT_HINT}")
    return 0


@dataclass
class CheckResult:
    """What `check` found, before anybody prints it.

    The split exists for `brief`, which needs both verdicts and the detail under
    them. It used to get them by running the two commands with stdout
    redirected into a buffer, which made one command's output another's input:
    anything written to stderr escaped the capture, the root was resolved and
    the notes loaded three times over, and the printing could not be changed
    without breaking the reuse.
    """
    problems: list[str]
    secrets: list[str]
    coverage: str
    count: int

    @property
    def code(self) -> int:
        # Secrets win the exit code even when there are problems too: a stale
        # table and a private key in a note are not the same kind of news, and
        # anything automating this needs to tell them apart.
        if self.secrets:
            return 4
        return 3 if self.problems else 0


@dataclass
class CheckCtx:
    """What every check is allowed to look at: the notes, and the overview as
    text. Anything else a check needs it derives itself, where the derivation
    can be read next to the use."""
    root: Path
    notes: list[Note]
    overview: str


def check_language(c: CheckCtx) -> list[str]:
    """Switching a kb's language is not a setting change. The mark and the table
    header flip on the next sync; the titles, the prose outside the markers and
    the entry point are written by hand and stay as they were, so the file ends
    up half in each. Saying it here is the point: the person who exported the
    variable learns what it costs before the half-translated file exists, and
    the steps arrive where they are acted on rather than in a manual nobody
    opens at that moment."""
    have = recorded_lang(c.root)
    if have and LANG_ENV and LANG_ENV != have:
        return [f"KB_LANG={LANG_ENV} but these notes are {have} — kb keeps writing "
                f"{have} until the kb itself is switched. To switch: translate the "
                f"`title:` of every note, the prose outside the markers in "
                f"{OVERVIEW}, and the filled sections of the entry point, then "
                f"`KB_LANG={LANG_ENV} kb sync`. Nothing translates by itself"]
    return []


def check_index(c: CheckCtx) -> list[str]:
    if replace_block(c.overview, "") is None:
        return ["no managed block in the overview — `kb adopt` or add the markers"]
    expected = render_block(c.notes)
    if MARK_BEGIN in c.overview and expected not in c.overview:
        return ["index table is stale — run `kb sync`"]
    return []


def check_links(c: CheckCtx) -> list[str]:
    """Notes cite each other, and those links break exactly when a file is
    renamed, superseded or split — the moments the overview survives untouched,
    because `sync` rewrites it from front matter either way."""
    # The overview is not a note -- load_notes() skips it, and rightly: it has no
    # kind and belongs in no generated table. But `known` doubles as "files that
    # exist" here, and leaving it out made a reference to 00-overview.md read as
    # broken -- the one file `check` separately insists must be there.
    known = {n.name for n in c.notes} | {OVERVIEW}
    # A file named in `supersedes:` is SUPPOSED to be gone -- the note that
    # replaced it says so. Naming it afterwards is how the record of a
    # replacement is kept readable, so it is history, not a broken link.
    retired = {r.strip() for n in c.notes
               for r in n.supersedes.replace(",", " ").split() if r.strip()}
    out = [f"overview links a missing file: {ref}"
           for ref in sorted(linked_files(c.overview) - known - retired)]
    for n in c.notes:
        out += [f"{n.name} links a missing file: {ref}"
                for ref in sorted(linked_files(n.text) - known - retired)
                if ref != n.name]
    return out


def check_front_matter(c: CheckCtx) -> list[str]:
    out = []
    for n in c.notes:
        if not n.has_fm:
            out.append(f"{n.name}: no front matter (kind/title guessed)")
        elif n.kind not in KINDS:
            out.append(f"{n.name}: unknown kind {n.kind!r}")
        # A date that is not a date sorts as a string against real ones and can
        # win. `updated` also drives the staleness check, which simply skips
        # what it cannot parse -- so a typo here disables two things quietly.
        if n.has_fm and n.updated and not ISO_DATE_RE.match(n.updated):
            out.append(
                f"{n.name}: updated is not a date: {n.updated!r} — expected YYYY-MM-DD")
        if n.kind == "state" and not ISO_DATE_RE.match(n.sort_date):
            out.append(f"{n.name}: a state with no date in its name and no usable "
                       "`updated` — it can never be the current snapshot")
    return out


def check_unanswered(c: CheckCtx) -> list[str]:
    """Two things `restore` reads that nothing ever made `save` write. The
    halves disagreed in silence: a briefing said "the situation now" and had no
    state to take it from, and "what this stream is" resolved to a TODO comment.
    Reported here rather than asked for in prose — prose was asked four times."""
    out = [f"{n.name}: a section is still empty — fill it or delete it, "
           "an unanswered heading is worse than none"
           for n in c.notes if "<!-- kb:fill" in n.text]
    if any(ph in c.overview for ph in ("<!-- одним абзацем", "<!-- one paragraph")):
        out.append(f"{OVERVIEW}: still has its placeholder — say in a line or two "
                   "what this work stream is and what does NOT go in it")
    return out


def check_entry_point(c: CheckCtx) -> list[str]:
    """`sync` keeps the entry point current on its own now, so a difference here
    means sync was not run: front matter edited by hand, or the block itself
    edited. Same finding as a stale index table, for the copy of those facts
    that lives outside the notes directory and is read first."""
    if route_drift(c.root, c.notes):
        return ["the entry point at the project root names a different snapshot "
                "or count than the notes do — run `kb sync`"]
    return []


def check_charter(c: CheckCtx) -> list[str]:
    """`add` refuses the second one; a hand-written file reaches here anyway,
    and two charters have no tie-breaker at all — not even a date, the way two
    snapshots do."""
    charters = [n.name for n in c.notes if n.kind == "charter"]
    if len(charters) > 1:
        return [f"{len(charters)} charters ({', '.join(charters)}) — a stream has "
                "one direction; nothing can pick between them. Merge into one and "
                "reverse the other with a `decision` that says why"]
    return []


def check_state_exists(c: CheckCtx) -> list[str]:
    if len(c.notes) >= 3 and not any(n.kind == "state" for n in c.notes):
        return [f"{len(c.notes)} notes and no `state` — nothing answers 'what is "
                "the situation now'; `kb add state --kind state` writes one"]
    return []


def check_whitespace(c: CheckCtx) -> list[str]:
    return [f"{n.name}: whitespace in the filename — a link to it can never be "
            "verified; rename with hyphens"
            for n in c.notes if any(ch.isspace() for ch in n.name)]


def check_titles(c: CheckCtx) -> list[str]:
    """`add` refuses a duplicate title now, which leaves the ones written before
    that and the ones edited by hand afterwards. Measured over 43 real notes in
    six directories: one group, and it was the real thing."""
    by_title: dict[str, list[str]] = {}
    for n in c.notes:
        by_title.setdefault(n.title.strip(), []).append(n.name)
    return [f"{len(names)} notes promise the reader {title!r} "
            f"({', '.join(names)}) — the index column answers 'what do I "
            "need?' and answers it identically; retitle all but one"
            for title, names in by_title.items() if len(names) > 1]


def check_strays(c: CheckCtx) -> list[str]:
    return [f"{p.name}: not in the NN-slug.md scheme, absent from the index"
            for p in sorted(c.root.glob("*.md"))
            if p.name != OVERVIEW and not NAME_RE.match(p.name)]


def check_size(c: CheckCtx) -> list[str]:
    out = []
    for n in sorted(c.notes, key=lambda n: -n.lines):
        if n.lines > HARD_LINES:
            out.append(f"{n.name}: {n.lines} lines (~{n.ktokens}k tokens) — one "
                       "Read is expensive. Split ONLY if the sections answer "
                       "different questions")
        elif n.lines > SOFT_LINES:
            out.append(f"{n.name}: {n.lines} lines — check whether the sections "
                       "answer different questions (size alone is not a reason)")
    return out


def check_backups(c: CheckCtx) -> list[str]:
    baks = list(c.root.glob("*.bak.*"))
    if baks:
        return [f"{len(baks)} *.bak.* file(s) — the index is generated now, these "
                "are safe to delete once you have checked them"]
    return []


# Fifteen independent questions used to sit in one body of 178 lines, in an
# order nobody could see and with the working values of one visible to the next.
# The list IS the order the findings are reported in, so adding a check is one
# function and one row, and reordering the report is moving the row.
CHECKS: list[tuple[str, "object"]] = [
    ("language", check_language),
    ("index", check_index),
    ("links", check_links),
    ("front-matter", check_front_matter),
    ("unanswered", check_unanswered),
    ("entry-point", check_entry_point),
    ("charter", check_charter),
    ("state-exists", check_state_exists),
    ("whitespace", check_whitespace),
    ("titles", check_titles),
    ("strays", check_strays),
    ("size", check_size),
    ("backups", check_backups),
]


def check_problems(root: Path, notes: list[Note]) -> CheckResult:
    ctx = CheckCtx(root=root, notes=notes,
                   overview=(root / OVERVIEW).read_text(encoding="utf-8"))
    problems = [p for _, fn in CHECKS for p in fn(ctx)]
    secrets, coverage = find_secrets(root, notes)
    return CheckResult(problems, secrets, coverage, len(notes))


def print_check(res: CheckResult, out=None) -> int:
    """`out=None` is stdout, which is what `print` does with `file=None` anyway.
    `brief` passes a buffer instead of redirecting the stream underneath."""
    if res.code == 0:
        print(f"clean: {res.count} files, index current", file=out)
        print(f"secrets: none found — checked with {res.coverage}", file=out)
        if "only" in res.coverage:
            print("         install gitleaks or trufflehog for the full ruleset",
                  file=out)
        return 0

    if res.problems:
        print(f"{len(res.problems)} problem(s):", file=out)
        for p in res.problems:
            print(f"  - {p}", file=out)

    if res.secrets:
        print(f"\nSECRETS ({len(res.secrets)}) — checked with {res.coverage}:",
              file=out)
        for hit in res.secrets:
            print(f"  ! {hit}", file=out)
        print("\n  Do not quietly rewrite the file: if it is under version control the"
              "\n  value is already in history, and a silent edit hides that. Tell the"
              "\n  human what was found and where, then rotate the credential."
              "\n  A short generic password in a sentence is caught by nothing here.",
              file=out)
        return 4

    print(f"\nsecrets: none found — checked with {res.coverage}", file=out)
    return 3


def cmd_check(args) -> int:
    root = find_root(args.dir)
    refuse_outside(root)
    return print_check(check_problems(root, load_notes(root)))


def scan_for_kbs(root: Path) -> list[Path]:
    """Walk root looking for directories that hold an overview."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
        dirnames[:] = [d for d in dirnames if d not in SCAN_SKIP]
        if OVERVIEW in filenames:
            found.append(Path(dirpath))
            dirnames[:] = []          # notes do not nest
    return found


def cmd_list(args) -> int:
    if args.scan:
        target = Path(args.scan)
        if not target.is_dir():
            die(f"not a directory: {target}")
        fresh = [p for p in scan_for_kbs(target) if p.resolve() not in read_registry()]
        for p in fresh:
            register(p)
        print(f"scan {target}: {len(fresh)} new")

    known = read_registry()
    if not known:
        print("registry is empty. `kb add` in a project creates a kb and records "
              "it here; `kb list --scan <dir>` picks up existing ones")
        return 0

    dead = []
    for path in known:
        if not (path / OVERVIEW).is_file():
            dead.append(path)
            continue
        notes = load_notes(path)
        cur = current_state(notes)
        heavy = sum(1 for n in notes if n.lines > HARD_LINES)
        bits = [f"{len(notes)} files"]
        if cur:
            bits.append(f"snapshot {cur.sort_date}")
        if heavy:
            bits.append(f"⚠ {heavy} heavy")
        print(f"  {str(path):<40} {', '.join(bits)}")

    for path in dead:
        print(f"  {str(path):<40} ✗ no {OVERVIEW} — moved or deleted")
    if dead and not args.prune:
        print(f"\n{len(dead)} dead entries. Remove: kb list --prune")
    if args.prune and dead:
        alive = [p for p in known if p not in dead]
        REGISTRY.write_text("".join(f"{p}\n" for p in alive), encoding="utf-8")
        print(f"removed {len(dead)}")
    return 0


# How long before a kind is worth re-checking. `decision` is absent on purpose:
# it records why a choice was made, which stays true however old it gets.
# `state` and `plan` are absent too — supersession already handles them.
# `charter` gets the longest window: direction is supposed to outlive a release,
# so flagging it early would train the reader to ignore the whole report. A year
# of silence about where a project is going is worth one look.
STALE_DAYS = {"charter": 365, "reference": 180, "recipe": 120}
# Work continuing this long after the last note was written is worth a look.
# Below it the answer is always yes on any active day -- a note, then a commit
# ten minutes later -- and a suspicion nobody can act on is one nobody reads.
UNWRITTEN_HOURS = 1


def checkable_paths(text: str) -> set[str]:
    """Absolute paths worth testing — deliberately narrow.

    Measured on a real kb: testing every path-looking token produced 271 flags
    of which about 2 were real, because URL paths (`/stats/prometheus`), API
    versions (`/v1alpha1`) and fragments of longer paths all look like paths. A
    report with that ratio teaches the reader to ignore it within days.

    Two constraints cut it to a reviewable handful:
      * only inside backticks — a mention in prose is not a claim about disk
      * the first two components must exist — that alone kills URLs, versions
        and fragments, since `/stats` and `/v1alpha1` are not directories here

    `~/…` counts as absolute and is expanded before testing. It was excluded at
    first as shell syntax rather than a path, which let the one shape people
    actually write for a file in their home directory through unchecked: a
    pointer into a home-directory tree outlived that tree by a day and was
    found by a human reading the file, not by this.
    """
    out = set()
    for raw in re.findall(r"`(~?/[A-Za-z0-9._/-]{6,})`", text):
        p = raw.rstrip(".,;:")
        if "..." in p:
            continue                    # elision in prose, not a literal path
        parts = Path(p).expanduser().as_posix().strip("/").split("/")
        if len(parts) < 2:
            continue
        anchor = Path("/") / parts[0]
        if anchor.is_dir() and (anchor / parts[1]).exists():
            out.add(p)
    return out


@dataclass
class VerifyResult:
    dead: dict[str, set[str]]
    aging: list
    moved: list[Path]
    gap_hours: float
    entry: list[str]

    @property
    def code(self) -> int:
        return 3 if (self.dead or self.aging or self.moved or self.entry) else 0


def verify_findings(root: Path, notes: list[Note]) -> VerifyResult:
    """Everything `verify` suspects, with nothing printed. See `cmd_verify`."""
    today = date.today()

    # The overview is scanned too, and it is the file that needed it most. Its
    # whole job is "where to start" and "that subject lives in the other kb",
    # so it carries more cross-stream paths than any note -- and `load_notes()`
    # skips it, because it has no `kind` and belongs in no generated table.
    # That exemption silently followed the set into the path check, and a dead
    # pointer sat in the first file every reader opens. Same shape as the link
    # check in 4.15.4: a set assembled for one purpose, reused for a second.
    # The entry point is scanned on the same terms. It is not a note, but it is
    # the one file an agent reads before touching anything, and a pointer in it
    # that no longer resolves sends the reader to a directory somebody moved.
    # Two of them survived a sweep of the notes and the code because they sat in
    # a `CLAUDE.md` -- which git ignored, so no commit hook saw them either.
    project = project_of(root)
    dead: dict[str, set[str]] = {}
    # The notes are already in memory; only the two files that are not notes are
    # opened here.
    sources = [(n.name, n.text) for n in notes]
    for path in [root / OVERVIEW] + route_files(project):
        if path.is_file():
            sources.append(
                (path.name, path.read_text(encoding="utf-8", errors="replace")))
    for name, text in sources:
        for p in checkable_paths(text):
            if not Path(p).expanduser().exists():
                dead.setdefault(p, set()).add(name)

    aging = []
    for n in notes:
        limit = STALE_DAYS.get(n.kind)
        if not limit:
            continue
        try:
            age = (today - date.fromisoformat(n.updated)).days
        except ValueError:
            continue
        if age > limit:
            aging.append((age, n))

    # The one drift kb could not see at all: the WORK moved and nothing was
    # written down. Every other check compares notes with notes -- index
    # against front matter, links against files, snapshots against each other
    # -- so a kb can be spotless and describe a state the work left long ago.
    #
    # Compared against the newest NOTE, not the newest snapshot, and only past
    # a threshold. The first version compared with the snapshot and fired on an
    # active day every time: notes written, then a release shipped ten minutes
    # later, and every session after that opened with a suspicion nobody could
    # act on. A report at that ratio stops being read. What is worth saying is
    # narrower and survives measurement: work went on for hours and produced no
    # note at all.
    #
    # Not git: four of six real work streams here are not repositories, and
    # "cannot check" reads as "fine". Times are not history either -- a
    # checkout moves them -- so this stays a suspicion and never a `check`.
    moved: list[Path] = []
    gap_hours = 0.0
    # Collected by the same traversal that looks for work, and handed to
    # `route_findings` so the project tree is walked once instead of twice.
    chains: list[tuple[Path, int, list[str]]] | None = None
    # Flat layout -- the directory IS the work stream -- has nothing to compare:
    # the notes and the work are the same files. Skipped, not silently passed.
    stream = root.parent if is_nested(root) else None
    if stream and stream.is_dir():
        try:
            since = max(f.stat().st_mtime for f in root.glob("*.md"))
        except (OSError, ValueError):
            since = None
        seen, capped = 0, False
        if since:
            chains = []
            for here, filenames in walk_stream(stream):
                if here != stream and {CLAUDE_FILE, LOCAL_FILE} & set(filenames):
                    total, parts = route_weight(stream, here)
                    if total > ROUTE_BUDGET:
                        chains.append((here, total, parts))
                for name in filenames:
                    # kb writes these itself. Counting them as work that outran
                    # the notes made `route` guarantee a false positive on the
                    # very next `verify`, naming the two files it had just
                    # created. They are a pointer to the notes rather than the
                    # work, and they have findings of their own further down.
                    if here == stream and name in (ROUTE_FILE, CLAUDE_FILE):
                        continue
                    seen += 1
                    if seen > 20000 or len(moved) > 200:
                        capped = True
                        break
                    p = here / name
                    try:
                        if p.stat().st_mtime > since + UNWRITTEN_HOURS * 3600:
                            moved.append(p)
                    except OSError:
                        pass
                if capped:
                    break
            # Stopping early leaves the budgets half-collected, and a finding
            # that disappears because the walk was cut short is worse than the
            # second walk it would have cost. Hand back nothing and let
            # `route_findings` do its own, which has no cap.
            if capped:
                chains = None
            else:
                chains.sort(key=lambda r: -r[1])
        if moved:
            newest = max(p.stat().st_mtime for p in moved)
            gap_hours = (newest - since) / 3600

    # The entry point is not a note and is not read on demand: it is expanded
    # into the context window at the start of every session, so it is the one
    # file here where length is a running cost rather than a one-off.
    entry = route_findings(root, chains=chains)
    return VerifyResult(dead, aging, moved, gap_hours, entry)


def print_verify(res: VerifyResult, out=None) -> int:
    if res.dead:
        print(f"paths that do not resolve ({len(res.dead)}) — some may live in a "
              "container or on another host, check by hand:", file=out)
        for p in sorted(res.dead):
            print(f"  ✗ {p}", file=out)
            print(f"      cited in: {', '.join(sorted(res.dead[p]))}", file=out)
    if res.aging:
        print(f"\nnot revisited in a while ({len(res.aging)}) — not necessarily "
              "wrong, just unverified:", file=out)
        for age, n in sorted(res.aging, reverse=True):
            print(f"  {age:>4}d  {n.name}  ({n.kind}, updated {n.updated})", file=out)
    if res.moved:
        newest = sorted(res.moved, key=lambda p: -p.stat().st_mtime)[:5]
        print(f"\nwork went on for {res.gap_hours:.0f}h after the last note was "
              f"written ({len(res.moved)} file(s)):", file=out)
        for p in newest:
            print(f"  {p}", file=out)
        if len(res.moved) > len(newest):
            print(f"  … and {len(res.moved) - len(newest)} more", file=out)
        print("  Every other check compares the notes with each other, so they "
              "stay clean while\n  describing a state the work has left. Read "
              "what changed; if it matters, it\n  belongs in a note.", file=out)

    if res.entry:
        print(f"\nthe entry point at the project root ({len(res.entry)}):", file=out)
        for f in res.entry:
            print(f"  ⚠ {f}", file=out)
        print("  These are conditions, not events: each one stays wrong until "
              "somebody fixes it,\n  and `route` said so only in the turn that "
              "wrote the file.", file=out)

    if res.code == 0:
        print("nothing suspicious: every checkable path resolves, no note is "
              "past its re-check age, and no work has outrun the notes", file=out)
        return 0
    print("\nAdvisory only. Whether a fact about a live cluster still holds "
          "cannot be answered here — only by a human or a command.", file=out)
    return 3


def cmd_verify(args) -> int:
    """Suspicions, not errors — deliberately separate from `check`.

    `check` is binary and mechanical: exit 3 means go fix it. This is
    probabilistic — a flagged path may live inside a container, on another host,
    or be an illustration. Merging the two would drown an exact signal in guesses.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    return print_verify(verify_findings(root, load_notes(root)))


HOOK_BODY = """#!/bin/sh
# Installed by `kb hook --install`. Blocks a commit when kb check finds a
# credential in the notes (exit 4). Other kb findings do not block.
"{kb}" --dir "{root}" check
[ $? -eq 4 ] && {{
    echo "commit refused: a credential was found in the notes (see above)" >&2
    exit 1
}}
exit 0
"""


def cmd_hook(args) -> int:
    """Install a git pre-commit hook that blocks on exit 4.

    Only useful when the notes are inside a git repository — plenty of them are
    not, which is why this is opt-in rather than part of install. Where there is
    no repository the real control is `kb check` running at the end of every
    save, which happens regardless.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    git_dir = find_git_dir(root)
    if not git_dir:
        die(f"{root} is not inside a git repository — nothing to hook into.\n"
            "  `kb check` still runs at the end of every save; that is the check\n"
            "  that applies when the notes are not versioned.")

    hook = git_dir / "hooks" / "pre-commit"
    body = HOOK_BODY.format(kb=Path(sys.argv[0]).resolve(), root=root.resolve())

    if hook.exists() and "kb hook --install" not in hook.read_text(
            encoding="utf-8", errors="replace"):
        die(f"{hook} exists and was not written by kb — refusing to overwrite.\n"
            "  Add this line to it by hand:\n"
            f'    "{Path(sys.argv[0]).resolve()}" --dir "{root.resolve()}" check '
            "|| [ $? -ne 4 ]")

    if args.dry_run:
        print(f"would write {hook}")
        return 0
    hook.parent.mkdir(parents=True, exist_ok=True)
    hook.write_text(body, encoding="utf-8")
    hook.chmod(0o755)
    print(f"installed {hook}")
    print("  a commit is now refused when a credential is found in the notes")
    return 0


ROUTE_FILE = "AGENTS.md"
CLAUDE_FILE = "CLAUDE.md"
# Personal, uncommitted, and loaded straight after `CLAUDE.md` in the same
# directory — so it is part of the bill whether or not anyone counts it.
LOCAL_FILE = "CLAUDE.local.md"
CLAUDE_IMPORT = "@AGENTS.md"

# The entry point is the one file here that does NOT get the notes' treatment.
# A note is read on demand, so length costs nothing until someone opens it --
# which is why SOFT_LINES/HARD_LINES are advisory and generous. This file is
# loaded at the start of every session and paid for on every turn, so the
# 200-line rule for always-loaded instruction files applies to it exactly.
# Measured as the SUM: `@AGENTS.md` is expanded into context alongside the
# CLAUDE.md that imports it, so counting either one alone understates the bill.
ROUTE_BUDGET = 200

# What to do about each finding is a page of instructions, and it is worth
# nothing on the saves where the entry point is fine -- which is most of them,
# since `route` runs about once per project. So the page is loaded on demand and
# the condition for loading it travels with the finding itself, printed by the
# tool rather than described in prose. Prose that asks the reader to notice a
# condition is the thing that gets skipped; an output line arrives whether or
# not anyone was looking for it.
ENTRY_POINT_HINT = "what to do about these: references/entry-point.md"


def route_findings(root: Path, *, on_write: bool = False,
                   chains: list | None = None) -> list[str]:
    """Everything wrong with the entry point, for whoever asks.

    `route` reported these in the turn that wrote the file and nowhere else, so
    a session that never re-ran it never heard them again. They are conditions,
    not events: a pointer committed while its notes are not stays wrong until
    somebody fixes it. `verify` asks this on every restore.
    """
    project = project_of(root)
    target = project / ROUTE_FILE
    if not target.is_file():
        return []                       # no entry point is a choice, not a fault
    out = []
    text = target.read_text(encoding="utf-8", errors="replace")
    # The same question `route` itself asks, asked the same way. A substring
    # test answered "the markers are there" for a file that merely mentions
    # `kb:begin` in its prose, while `route` -- which needs both markers, in
    # order -- refused to write. Two answers to one question, and the finding
    # went missing exactly where it was true.
    if replace_block(text, "") is None:
        out.append(f"{target.name} has no kb:begin/kb:end markers, so nothing "
                   "keeps it current — add them where the pointer belongs")
    claude = project / CLAUDE_FILE
    if not claude.is_file():
        out.append(f"{CLAUDE_FILE} is missing — Claude Code reads it and not "
                   f"{ROUTE_FILE}; one line `{CLAUDE_IMPORT}` restores the link")
    elif CLAUDE_IMPORT not in claude.read_text(encoding="utf-8", errors="replace"):
        out.append(f"{CLAUDE_FILE} does not import {ROUTE_FILE} — add "
                   f"`{CLAUDE_IMPORT}` at the top")
    # Both directions, because each ships half of a pair. Only the first was
    # thought of at first, and the repository that found the second had the
    # opposite arrangement: every AI artifact ignored by policy, the notes not
    # yet named in that policy.
    state, ignored = git_state(root), git_ignores(target)
    if state == "local" and not ignored:
        # "committed" was the word here and it was not true: the file is
        # merely not excluded, and in a repository with no commits at all
        # nothing is committed. A finding that overstates the state is acted on
        # against a situation that does not exist.
        out.append(f"{target.name} is not excluded while {root.name}/ is — the "
                   f"next `git add -A` commits it, and a clone then gets a "
                   f"pointer to a directory it does not have")
    elif state == "versioned" and ignored and on_write:
        # Only where the file is being written, and deliberately not on every
        # save and every restore. The two directions are not equally bad: a
        # committed pointer to excluded notes ships a promise nothing can keep,
        # while this one ships the notes and omits the signpost — the reader
        # still has everything. It also follows from a choice the human already
        # made, when `add` asked whether the notes are committed, and a
        # repository whose policy excludes every AI artifact answers it the same
        # way every time. Repeated each session it would be furniture.
        #
        # The cost, stated because it is real: `route` runs about once per
        # project, so this may go unseen. That is the trade accepted for it.
        out.append(f"{root.name}/ is tracked while {target.name} is excluded — "
                   "the notes reach a clone and nothing there points at them")
    # The instructions for filling these live in the page named beside every
    # finding, and that page loads on demand. Without this condition the page
    # was unreachable at the one moment it is needed: `route` creates the slots
    # and prints nothing, so a first save filled them from memory and repeated
    # the two mistakes the page exists to prevent. Measured twice, on the same
    # stream, by a human who had followed the procedure correctly.
    if "<!-- kb:fill" in text:
        out.append(f"{target.name} has sections nobody has answered yet — fill "
                   "them from this session, do not hand them back")
    total, parts = route_weight(project)
    if total > ROUTE_BUDGET:
        out.append(f"{total} lines of context every session ({', '.join(parts)}), "
                   f"budget {ROUTE_BUDGET} — move what is not routing into a note")
    # A component directory pays for its own instruction file plus every one
    # above it. Reported after the root so the cheaper fix is read first: the
    # root line is in every chain, and shortening it shortens all of them.
    # `verify` collects these in the walk it is doing anyway and passes them in;
    # everybody else pays for the walk here.
    if chains is None:
        chains = route_chains(project)
    for here, n, parts in chains[:3]:
        rel = os.path.relpath(here, project).replace(os.sep, "/")
        out.append(f"a session started in {rel}/ loads {n} lines "
                   f"({', '.join(parts)}), budget {ROUTE_BUDGET}")
    if len(chains) > 3:
        out.append(f"… and {len(chains) - 3} more subdirectories over the budget")
    return out


IMPORT_RE = re.compile(r"^@(\S+)", re.M)
IMPORT_DEPTH = 4        # Claude Code stops here; counting further would overstate


def _imports(f: Path, depth: int, seen: set[Path]) -> list[Path]:
    """Files an `@path` line pulls in, recursively, the way the host expands them.

    Counting only the two files at the project root said 35 lines where 635
    reached the context window: an import is expanded at launch, so the lines
    are paid for wherever they are written. A budget that ignores them is
    silent exactly on the files that overrun it worst.
    """
    if depth <= 0:
        return []
    out = []
    for raw in IMPORT_RE.findall(f.read_text(encoding="utf-8", errors="replace")):
        p = Path(raw).expanduser()
        if not p.is_absolute():
            p = f.parent / p
        try:
            p = p.resolve()
        except OSError:
            continue
        if p in seen or not p.is_file():
            continue
        seen.add(p)
        out.append(p)
        out.extend(_imports(p, depth - 1, seen))
    return out


def _ancestry(start: Path, project: Path) -> list[Path]:
    """Directories from just under `project` down to `start`, outermost first."""
    chain, p = [], start
    while p != project and p.parent != p:
        chain.append(p)
        p = p.parent
    return list(reversed(chain)) if p == project else []


def _label(f: Path, project: Path) -> str:
    """`AGENTS.md` at the root, `web/CLAUDE.md` below it.

    A chain names several files called `CLAUDE.md` and the bare name cannot say
    which is which.
    """
    try:
        return f.relative_to(project).as_posix()
    except ValueError:
        return f.name


def route_files(project: Path, start: Path | None = None) -> list[Path]:
    """Files expanded into context when a session starts in `start`.

    The host loads `CLAUDE.md` and `CLAUDE.local.md` from the launch directory
    and every directory above it, the local file after the shared one at each
    level; `AGENTS.md` arrives only through the `@` import the root `CLAUDE.md`
    carries, and is named here as well because a Codex-only project has it with
    no `CLAUDE.md` at all.
    """
    roots = [project / CLAUDE_FILE, project / ROUTE_FILE, project / LOCAL_FILE]
    for d in _ancestry(start, project) if start else []:
        roots += [d / CLAUDE_FILE, d / LOCAL_FILE]
    files = [r for r in roots if r.is_file()]
    # Seeded with the files themselves: `CLAUDE.md` imports `AGENTS.md` in the
    # layout this tool writes, and without the seed that file is counted twice.
    seen: set[Path] = {f.resolve() for f in files}
    return files + [i for f in files for i in _imports(f, IMPORT_DEPTH, seen)]


def route_weight(project: Path, start: Path | None = None) -> tuple[int, list[str]]:
    """Lines that reach the context window at session start, and their sources."""
    total, parts = 0, []
    for f in route_files(project, start):
        if f.is_file():
            # splitlines, not count("\n") + 1: this number is compared against a
            # documented budget and the reader checks it with `wc -l`. The note
            # counter overstates a newline-terminated file by one, which nobody
            # notices at a 400-line advisory and everybody would at 200.
            n = len(f.read_text(encoding="utf-8", errors="replace").splitlines())
            total += n
            parts.append(f"{_label(f, project)} {n}")
    return total, parts


def walk_stream(project: Path):
    """The work tree of one stream: `(directory, filenames)`, pruned once.

    Two callers wanted the same traversal with the same exclusions -- the
    subdirectory budgets here, and "the work outran the notes" in `verify` --
    and each had written its own. Running both meant walking the project twice
    and asking git twice which children it ignores, per `verify`; worse, the two
    prune lists had to be kept identical by hand, and a directory excluded from
    one was already counted by the other.
    """
    ignored = git_ignored_children(project)
    for dirpath, dirnames, filenames in os.walk(project, onerror=lambda e: None):
        here = Path(dirpath)
        dirnames[:] = [d for d in dirnames
                       if d not in SCAN_SKIP and not d.startswith(".")
                       # Another stream's notes are not this stream's work, and
                       # its entry point is that stream's budget. A nested kb
                       # reported its own overview as evidence that the parent
                       # had moved on, which is true of neither.
                       and not is_stream(here / d)
                       # Generated output is not work either. A backup pipeline
                       # rewrote 201 files under an ignored directory on every
                       # run, so its notes could never stop looking stale. Only
                       # asked where git can answer -- most streams here are not
                       # repositories, and that stays as it was.
                       and (here / d).resolve() not in ignored]
        yield here, filenames


def route_chains(project: Path) -> list[tuple[Path, int, list[str]]]:
    """Per subdirectory with its own instruction file, what a session there loads.

    The budget was measured for the project root only, where it is the cheapest
    thing to see: two files, one sum. A session started in a component directory
    loads that directory's `CLAUDE.md` on top of every ancestor's, and that sum
    was nobody's — a component at 124 lines under a root at 100 overran a budget
    neither file broke on its own, and a human found it by reading.
    """
    out = []
    for here, filenames in walk_stream(project):
        if here == project or not ({CLAUDE_FILE, LOCAL_FILE} & set(filenames)):
            continue
        total, parts = route_weight(project, here)
        if total > ROUTE_BUDGET:
            out.append((here, total, parts))
    return sorted(out, key=lambda r: -r[1])


def render_route_block(root: Path, project: Path, notes: list[Note]) -> str:
    """The part of the entry point kb derives. Everything else is the human's."""
    rel = os.path.relpath(root, project).replace(os.sep, "/")
    cur = current_state(notes)
    charter = next((n for n in notes if n.kind == "charter"), None)
    pointers = []
    if charter:
        pointers.append(S("route_charter").format(path=f"{rel}/{charter.name}"))
    if cur:
        pointers.append(S("route_current").format(path=f"{rel}/{cur.name}"))
    # The value carries its own trailing blank line and the template does not,
    # so an empty group collapses instead of leaving a hole. The other way
    # round -- a newline in the template -- put two blank lines into every kb
    # that had neither a charter nor a snapshot, which is every kb on day one.
    joined = "".join(f"{p}\n" for p in pointers)
    body = S("route_block").format(
        rel=f"{rel}/", count=len(notes),
        pointers=f"{joined}\n" if joined else "")
    return MARK_BEGIN + S("route_note") + "\n\n" + body.rstrip() + "\n\n" + MARK_END


def cmd_route(args) -> int:
    """Entry point at the project root, so the notes are found without kb.

    Everything else here assumes someone runs `kb brief`. Nobody who does not
    already know about the notes ever does, which makes a kb invisible to the
    reader who needs it most: a fresh session, another assistant, a new person.
    An agent reads the file at the root of the repository and always has.

    Two files, one source. Claude Code reads `CLAUDE.md` and NOT `AGENTS.md`
    (its own documentation says so); Codex and Opencode read `AGENTS.md`. So
    `AGENTS.md` carries the content and `CLAUDE.md` is one `@AGENTS.md` import,
    which is the pattern Anthropic documents for exactly this case. Detecting
    which assistant is running and writing only its file would break on the move
    that makes the whole thing worth doing -- start in one, continue in another.
    A symlink works too, but needs Administrator or Developer Mode on Windows,
    and kb ships an installer for Windows.

    The generated block holds only what kb can derive. Check commands and the
    definition of done sit OUTSIDE the markers, written once: kb does not know
    them, and a fill slot inside the block would be erased by the next run.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    project = project_of(root)
    refuse_outside(project)
    notes = load_notes(root)
    block = render_route_block(root, project, notes)
    refused = False

    target = project / ROUTE_FILE
    if not target.exists():
        target.write_text(
            S("route_skeleton").format(title=project.name, block=block),
            encoding="utf-8")
        print(f"created {target}")
        print("  fill the sections marked kb:fill — kb cannot know your commands")
    else:
        text = target.read_text(encoding="utf-8")
        new = replace_block(text, block)
        if new is None:
            # Reported, and the command carries on. Dying here also skipped the
            # CLAUDE.md step, so a project with a hand-written AGENTS.md and no
            # CLAUDE.md got nothing at all -- and Claude Code reads only the
            # second one. The import is worth writing whether or not the file it
            # points at carries a kb block: it links an instruction file that
            # already exists to the assistant that cannot see it.
            print(f"{target} exists and has no managed block — not writing to a "
                  "file someone else wrote.")
            print("  Add these two lines where the pointer to the notes belongs, "
                  "then re-run:")
            print(f"    {MARK_BEGIN} -->\n    {MARK_END}")
            refused = True
        elif new == text:
            print(f"{target} already current")
        else:
            target.write_text(new, encoding="utf-8")
            print(f"updated the managed block in {target}")

    claude = project / CLAUDE_FILE
    if not claude.exists():
        claude.write_text(f"{CLAUDE_IMPORT}\n", encoding="utf-8")
        print(f"created {claude} — one line importing {ROUTE_FILE}, no duplicate")
    elif CLAUDE_IMPORT in claude.read_text(encoding="utf-8"):
        print(f"{claude} already imports {ROUTE_FILE}")
    else:
        # Not prepended silently: this is an instruction file a human wrote, and
        # a line appearing in it that nobody typed is the kind of edit kb refuses
        # everywhere else.
        print(f"{claude} exists and does not import {ROUTE_FILE}.")
        print(f"  Add this line at the top yourself:\n    {CLAUDE_IMPORT}")

    # One implementation, asked by three commands. `route` used to carry its
    # own copy of the git check and its own copy of the budget check, so a
    # condition added to one was invisible to the others -- which is exactly
    # how the reverse mismatch shipped undetected here.
    findings = route_findings(root, on_write=True)
    for finding in findings:
        print(f"\n⚠ {finding}")
    if findings:
        print(ENTRY_POINT_HINT)

    return 1 if refused else 0


def cmd_local(args) -> int:
    """Keep the notes on this machine — `.git/info/exclude`, not `.gitignore`.

    `.gitignore` is itself committed, so it imposes one person's choice on
    everyone who clones the repository. `exclude` is per-checkout: it says the
    same thing without deciding for anybody else.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    git_dir = find_git_dir(root)
    if git_dir is None:
        die(f"{root} is not inside a git repository — nothing to exclude from")

    repo = git_dir.parent
    # The flat layout put directly on a repository root has nothing to exclude:
    # the pattern for "this directory" relative to itself is `/./`, which git
    # does not understand and which was written out verbatim. There is no
    # pattern that means "the whole repository", so the fix is not a better
    # pattern -- it is saying that this arrangement and `kb local` do not meet.
    if absolute(root) == absolute(repo):
        die(f"{root} IS the repository root — there is no exclude rule for a "
            "whole repository, so the notes here cannot be kept out of git.\n"
            "  Either move them into a directory of their own (`kb adopt` "
            f"offers {NOTES_DIRS[0]}/), or keep this repository private.")

    state = git_state(root)
    if state == "versioned":
        die(f"{root / OVERVIEW} is already tracked. An exclude rule would change "
            "nothing — git does not apply them to files it already tracks.\n"
            "  `git rm -r --cached` the directory first, and decide what to do "
            "about the history: the notes are already in it.")
    # No early return on "the notes are already excluded". Run before `route`
    # there is no entry point yet, so only the notes get a rule; run again
    # afterwards and this branch used to answer "nothing to do" while the
    # pointer sat there for the next `git add -A`. The mismatch finding then
    # fired and the file had to be edited by hand. The command is about the
    # decision, not about one directory, so it checks all of it every time and
    # says "nothing to do" only when all of it is already listed.
    rel = os.path.relpath(root.resolve(), repo.resolve()).replace(os.sep, "/")
    exclude = git_dir / "info" / "exclude"
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    listed = [line.strip() for line in existing.splitlines()]

    # The notes and the file that points at them are one decision, not two.
    # Excluding only the notes leaves a pointer that the next `git add -A`
    # commits, promising a clone a directory it will never get -- which is a
    # finding this tool already reports, and reporting a state the tool itself
    # created is worse than not creating it. Only files kb wrote are touched:
    # an `AGENTS.md` without the markers belongs to somebody, and a `CLAUDE.md`
    # holding anything but the import does too.
    project = project_of(root)
    wants = [f"/{rel}/"]
    for name in (ROUTE_FILE, CLAUDE_FILE):
        f = project / name
        if not f.is_file():
            continue
        body = f.read_text(encoding="utf-8", errors="replace")
        mine = MARK_BEGIN in body if name == ROUTE_FILE else body.strip() == CLAUDE_IMPORT
        if mine:
            wants.append("/" + os.path.relpath(f.resolve(),
                                               repo.resolve()).replace(os.sep, "/"))

    missing = [w for w in wants if w not in listed]
    if not missing:
        print(f"{exclude} already lists {', '.join(wants)} — nothing to do")
        return 0
    if args.dry_run:
        print(f"would append {', '.join(missing)} to {exclude}")
        return 0
    exclude.parent.mkdir(parents=True, exist_ok=True)
    sep = "" if not existing or existing.endswith("\n") else "\n"
    exclude.write_text(existing + sep + "".join(f"{w}\n" for w in missing),
                       encoding="utf-8")
    print(f"appended {', '.join(missing)} to {exclude}")
    print("  the notes stay on this machine; nothing about them is committed")
    kept = [w for w in wants[1:] if w not in missing]
    if len(wants) > 1:
        print("  the entry point goes with them — a pointer without its notes "
              "is a promise a clone cannot keep")
    if kept:
        print(f"  already listed: {', '.join(kept)}")
    return 0


def cmd_outline(args) -> int:
    """Heading map with per-section line counts — the cheap input for a split call.

    Deciding whether a 1900-line file should be split does not require reading
    1900 lines. It requires knowing which questions its sections answer, and a
    dozen headings carry that. Size is never the criterion (a long coherent
    reference is fine); the criterion is whether the sections belong to
    different KINDS, and this is what makes that visible for a few tokens.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    targets = ([root / args.file] if args.file
               else [n.path for n in sorted(load_notes(root), key=lambda n: -n.lines)
                     if n.lines > SOFT_LINES])
    if not targets:
        print(f"no files over {SOFT_LINES} lines — nothing to split")
        return 0
    for path in targets:
        if not path.is_file():
            die(f"no such file: {path}")
        lines = path.read_text(encoding="utf-8", errors="replace").split("\n")
        heads = [(i, ln) for i, ln in enumerate(lines) if ln.startswith("## ")]
        print(f"\n── {path.name}  ({len(lines)} lines) ──")
        if not heads:
            print("  no `## ` sections — no seams visible")
            continue
        for idx, (i, ln) in enumerate(heads):
            end = heads[idx + 1][0] if idx + 1 < len(heads) else len(lines)
            print(f"  {end - i:>5}  {ln[3:]}")
    return 0


# ── which work streams did a session touch ─────────────────────────────────
# The question `save` opens with, answered from evidence instead of recall.
# Recall returns the directory you happen to be standing in and reads as
# complete either way; after the conversation has been compacted it is provably
# not, and nothing from the inside distinguishes the two.
#
# Transcripts are per-harness and none of this is guaranteed to exist, so every
# probe is best-effort and absence is reported rather than papered over.
# DIRECTORIES are extracted, not prose: the question is which streams, and paths
# cost roughly a tenth of what the messages do.
TRANSCRIPTS = [
    ("claude", Path.home() / ".claude/projects", "*.jsonl"),
    ("codex",  Path.home() / ".codex/sessions",  "rollout-*.jsonl"),
]
OC_DB = Path.home() / ".local/share/opencode/opencode.db"
PATH_RE = re.compile(r"(?:/[A-Za-z0-9._-]+){2,}|~/[A-Za-z0-9._/-]+")


def _transcript_cwd(path: Path) -> str | None:
    """The directory a transcript belongs to, from the transcript itself.

    Claude Code stamps `cwd` on its entries; Codex carries it in the opening
    `session_meta`. Without this the newest file on the machine wins, and a
    session in one directory happily reports another's work -- which is exactly
    what happened: opencode in /1 was handed a Claude session's directories.
    """
    try:
        with path.open(encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 40:
                    break
                try:
                    d = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue
                if isinstance(d.get("cwd"), str):
                    return d["cwd"]
                if d.get("type") == "session_meta":
                    c = (d.get("payload") or {}).get("cwd")
                    if isinstance(c, str):
                        return c
    except OSError:
        pass
    return None


def _newest_transcripts(limit: int, only_cwd: bool = True) -> list[tuple[str, Path]]:
    cwd = str(Path.cwd().resolve())
    found = []
    for harness, root, pattern in TRANSCRIPTS:
        if not root.is_dir():
            continue
        for f in root.rglob(pattern):
            try:
                mtime = f.stat().st_mtime
            except OSError:
                continue
            if only_cwd:
                owner = _transcript_cwd(f)
                if owner is None or str(Path(owner).resolve()) != cwd:
                    continue
            found.append((mtime, harness, f))
    found.sort(reverse=True)
    return [(h, f) for _, h, f in found[:limit]]


def _user_messages(path: Path):
    """User turns from a JSONL transcript, across harness formats.

    Claude Code writes `{"type":"user","message":{"content":"..."}}`.
    Codex writes `{"type":"response_item","payload":{"role":"user",
    "content":[{"type":"input_text","text":"..."}]}}` — a different envelope,
    a different key, and content as blocks. Keying on the role rather than the
    envelope covers both; keying on `type == "user"` covered only the first,
    which is what an untested claim of Codex support looked like.
    """
    with path.open(encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                d = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            msg = d.get("message") or d.get("payload") or {}
            if not isinstance(msg, dict):
                continue
            role = msg.get("role") or (d.get("type") if d.get("type") == "user" else None)
            if role != "user":
                continue
            c = msg.get("content")
            if isinstance(c, list):
                c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
            if isinstance(c, str) and c.strip():
                yield " ".join(c.split())


def _opencode_sessions(limit: int):
    """Opencode keeps sessions in sqlite rather than files, so it cannot join
    the mtime sort above — it gets asked separately, but automatically. Behind a
    flag it would be invisible to the one person who needs it: whoever is
    running inside Opencode.

    The text lives in `part.data`, joined to `message` for the role. Reading
    every string column instead returns tool output and file contents; a first
    attempt produced `/_next/static` twenty-six thousand times.
    """
    if not OC_DB.is_file():
        return []
    import sqlite3
    out = []
    try:
        con = sqlite3.connect(f"file:{OC_DB}?mode=ro", uri=True)
        cwd = str(Path.cwd().resolve())
        sessions = [(sid, d) for sid, d in con.execute(
            "SELECT id, directory FROM session "
            "ORDER BY time_updated DESC LIMIT 200").fetchall()
            if d and str(Path(d).resolve()) == cwd][:limit]
        for sid, directory in sessions:
            texts = []
            for (blob,) in con.execute(
                    "SELECT p.data FROM part p JOIN message m "
                    "ON p.message_id = m.id "
                    "WHERE m.session_id = ? "
                    "AND json_extract(m.data, '$.role') = 'user'", (sid,)):
                try:
                    d = json.loads(blob)
                except (json.JSONDecodeError, ValueError):
                    continue
                if d.get("type") == "text" and isinstance(d.get("text"), str):
                    texts.append(" ".join(d["text"].split()))
            if texts:
                out.append((f"opencode:{directory}", texts))
        con.close()
    except sqlite3.Error:
        return out
    return out


def here_stream() -> str:
    """The directory this session is standing in, and its notes if it has any.

    Printed before the transcript tally and never taken from it. `streams` reads
    what was typed, so a stream nobody named is a stream it cannot see -- and
    the one directory that is certainly in scope is the one the session is
    working in. Measured on a real save: the sweep listed skill paths, transcript
    files and `~/.local/bin`, and not the directory the notes were written to,
    because nobody had typed its name. Whoever relayed that list had to work
    around the tool to reach the obvious answer.
    """
    cwd = Path.cwd().resolve()
    found = None
    for base in search_bases(cwd):
        for name in NOTES_DIRS:
            if (base / name / OVERVIEW).exists():
                found = base / name
                break
        if found:
            break
    if found is None and (cwd / OVERVIEW).exists():
        found = cwd                     # flat layout: the directory IS the kb
    if found is None:
        return f"  here: {cwd} — no kb yet"
    n = len(load_notes(found))
    where = found if found == cwd else os.path.relpath(found, cwd)
    return f"  here: {cwd} — kb at {where} ({n} note(s))"


def cmd_streams(args) -> int:
    print(here_stream())
    sources, texts = [], []
    for harness, path in _newest_transcripts(args.sessions):
        got = list(_user_messages(path))
        if got:
            sources.append(harness)
            texts.extend(got)
    for label, got in _opencode_sessions(args.sessions):
        sources.append(label.split(":")[0])
        texts.extend(got)

    if not texts:
        print(f"no transcript for {Path.cwd()} — this session may be too new to "
              "have one, or the harness keeps it somewhere this does not know "
              "about.\nOther sessions' transcripts are deliberately NOT read: "
              "they describe someone else's work.\nEnumerate the streams by "
              "hand, and say the list is from memory.")
        return 1

    seen = set()
    paths, pathless = {}, []
    for t in texts:
        if t.startswith(("<", "Caveat", "#")) or t in seen:
            continue
        seen.add(t)
        hits = PATH_RE.findall(t)
        if hits:
            for h in hits:
                root = "/".join(h.rstrip('.,;:)"\'').split("/")[:3])
                paths[root] = paths.get(root, 0) + 1
        elif len(t) >= 30:
            pathless.append(t[:52])

    tally = {h: sources.count(h) for h in dict.fromkeys(sources)}
    print("  read: " + ", ".join(f"{h} ×{n}" for h, n in tally.items()))
    print()
    for root, n in sorted(paths.items(), key=lambda kv: -kv[1])[:args.top]:
        print(f"  {n:>3}  {root}")
    if pathless:
        print(f"\n  mentioning no path ({len(pathless)}) — work with no directory "
              "does not appear above at all:")
        for line in pathless[:6]:
            print(f"    • {line}")
    return 0


def why_current(notes: list[Note], cur: Note) -> str:
    """Say out loud why THIS snapshot won.

    The rule is `max(date in the name, then number)`. On a day with one
    snapshot the date explains it. On a day with three the date column shows
    the same value three times and the tie is broken by a number that means
    nothing to a reader -- so the answer reads as arbitrary unless the reason
    is printed with it.
    """
    same = [n for n in notes if n.kind == "state" and n.sort_date == cur.sort_date]
    if len(same) > 1:
        return (f"latest date in a filename ({cur.sort_date}); "
                f"{len(same)} snapshots carry that date, the highest number wins")
    return f"latest date in a filename ({cur.sort_date})"


def cmd_brief(args) -> int:
    """The notes as they are written, not as anyone would summarise them.

    `restore` is a briefing: it reads what the task needs and phrases it, so
    two runs never match word for word and the choice of files depends on the
    task. That is right for "what should I read now" and wrong for "show me
    what is written" -- and the second question is the one asked when work
    resumes after two days. Same files in, same bytes out, no model involved.
    """
    root = find_root(args.dir)
    refuse_outside(root)
    notes = load_notes(root)
    cur = current_state(notes)

    # Addressed to whoever is relaying this, and it took two tries to word.
    # "Report what it said and stop" produced a paraphrase with an error in it
    # -- four releases rendered as five numbers. "Do not summarise it" produced
    # the opposite failure: the tool output sat in a collapsed block and the
    # assistant added the single sentence "the output above is verbatim",
    # having read nothing. Both halves have to be asked for, because the
    # display and the understanding are done by different parties.
    print("# The lines below ARE the notes, and the reader can see them. Do not "
          "retell them.")
    print("# After them, say in the reader's language what the work is, where "
          "it stands, what is")
    print("# open or planned next, and which of the notes you would open for "
          "the task at hand.")
    print(f"# kb {root} — {len(notes)} notes")

    # One command has to cover it. Three -- brief, then check, then verify --
    # is three chances to skip the third, and the third is the one that knows
    # whether these notes still describe the work. Their verdict goes above the
    # notes, the detail only when there is any: a stale kb must never read like
    # a current one just because nobody typed the last command.
    # The root is resolved and the notes loaded once for all three answers. The
    # previous shape ran the two commands with stdout redirected into a buffer,
    # which did the whole job three times over and quietly dropped anything they
    # wrote to stderr.
    checks = io.StringIO()
    rc_check = print_check(check_problems(root, notes), out=checks)
    rc_verify = print_verify(verify_findings(root, notes), out=checks)
    detail = checks.getvalue().strip()
    if rc_check == 4:
        print("# check: A CREDENTIAL IS IN THE NOTES — see below; do not edit "
              "the file silently")
    elif rc_check == 3:
        print("# check: the notes disagree with themselves — see below")
    else:
        print("# check: clean")
    print("# verify: " + ("suspicions — see below, the notes may have gone "
                          "stale" if rc_verify == 3 else "nothing suspicious"))
    if rc_check != 0 or rc_verify != 0:
        print()
        for line in detail.split("\n"):
            print(f"  {line}" if line.strip() else "")
    if cur:
        print(f"# current snapshot: {cur.name}")
        print(f"#   chosen by: {why_current(notes, cur)}")
    else:
        print("# current snapshot: none — no state note in this kb")
    print()

    # The overview whole: the prose saying what the stream is, and the table
    # saying which file answers what. Printed rather than described -- the
    # description is what varies.
    print(f"───── {OVERVIEW} " + "─" * max(0, 60 - len(OVERVIEW)))
    print((root / OVERVIEW).read_text(encoding="utf-8").rstrip())
    print()

    # Before the snapshot, because it is the question the snapshot assumes an
    # answer to: a list of what is done and open means nothing to someone who
    # does not yet know what the work is for or what it deliberately excludes.
    charter = next((n for n in notes if n.kind == "charter"), None)
    if charter:
        print(f"───── {charter.name} " + "─" * max(0, 60 - len(charter.name)))
        if charter.lines > HARD_LINES:
            print(f"{charter.lines} lines (~{charter.ktokens}k tokens) — too big to "
                  f"inline here. Open it: {charter.path}")
        else:
            print(charter.text.rstrip())
        print()

    if cur:
        print(f"───── {cur.name} " + "─" * max(0, 60 - len(cur.name)))
        print(cur.text.rstrip())
        print()

    shown = {n.name for n in (cur, charter) if n}
    rest = [n for n in notes if n.name not in shown]
    def row(n: Note) -> str:
        mark = " ⚠" if n.lines > HARD_LINES else ""
        return f"  {n.name:<34} {n.kind:<10} {n.title}{mark}"

    # Plans first, and named as such. A snapshot answers where things stand;
    # work that is sequenced but not yet done lives in a `plan`, and in a kb of
    # twenty notes a plan listed among the references is a plan nobody opens.
    # Not printed in full on purpose -- one of them runs to nineteen thousand
    # tokens, which is the whole budget of the briefing several times over.
    plans = [n for n in rest if n.kind == "plan"]
    if plans:
        print("───── planned work — the steps are in these, not above " + "─" * 7)
        for n in sorted(plans, key=lambda n: n.num):
            print(row(n))
        print()

    others = [n for n in rest if n.kind != "plan"]
    if others:
        print("───── the rest, open by the question it answers " + "─" * 14)
        for n in sorted(others, key=lambda n: n.num):
            print(row(n))
    return 0


def cmd_status(args) -> int:
    root = find_root(args.dir)
    refuse_outside(root)
    notes = load_notes(root)
    cur = current_state(notes)
    print(f"kb root: {root}   files: {len(notes)}")
    said = {"versioned": "git: tracked — the notes ship with the repository",
            "local": "git: excluded — the notes stay on this machine",
            "undecided": "git: neither tracked nor ignored — `kb local` keeps "
                         "them here, a commit shares them"}.get(git_state(root))
    if said:
        print(said)
    if cur:
        print(f"current state: {cur.name} — {why_current(notes, cur)}")
    by_kind: dict[str, int] = {}
    for n in notes:
        by_kind[n.kind] = by_kind.get(n.kind, 0) + 1
    for kind in KINDS:
        if by_kind.get(kind):
            print(f"  {kind:<10} {by_kind[kind]}")
    unknown = {k: v for k, v in by_kind.items() if k not in KINDS}
    for k, v in unknown.items():
        print(f"  {k:<10} {v}  (unknown kind)")
    big = [n for n in sorted(notes, key=lambda n: -n.lines) if n.lines > SOFT_LINES]
    if big:
        print("largest:")
        for n in big[:5]:
            mark = " ⚠" if n.lines > HARD_LINES else ""
            print(f"  {n.lines:>5} lines  ~{n.ktokens:>2}k  {n.name}{mark}")
    return 0


def plan_renames(root: Path) -> list[tuple[Path, Path]]:
    """Unnumbered `*.md` → the next free numbers, in name order.

    Deterministic on purpose: the same directory adopted twice produces the same
    numbers, so a preview can be trusted to describe the apply that follows.
    """
    taken = {n.num for n in load_notes(root)}
    nxt = max(taken, default=0) + 1
    out = []
    for src in sorted(root.glob("*.md")):
        if src.name == OVERVIEW or NAME_RE.match(src.name):
            continue
        slug = "-".join(src.stem.split())
        out.append((src, root / f"{nxt:02d}-{slug}.md"))
        nxt += 1
    return out


def cmd_adopt(args) -> int:
    """Retrofit an existing hand-made directory: front matter + markers.

    Preview by default; `--apply` writes. Front matter is PREPENDED, nothing in
    the body is rewritten — the guessed kind and the H1-derived title are a
    starting point for the human to correct, not a claim to be right.
    """
    root = find_root(args.dir)
    refuse_outside(root)

    # A hand-made directory rarely uses NN- names -- that convention is what
    # adopt is supposed to INTRODUCE. Numbering them is therefore part of the
    # job, not a precondition for it: without this, adopt silently reported
    # "0 numbered files" on exactly the directories it exists for.
    renames = plan_renames(root)
    if renames:
        print(f"── kb adopt: numbering {len(renames)} unnumbered file(s) ──")
        for src, dst in renames:
            print(f"  {src.name}  →  {dst.name}")
        if args.apply:
            for src, dst in renames:
                shutil.move(str(src), str(dst))
            print(f"  renamed {len(renames)}")

    # Notes belong in a directory of their own, never loose in the project root —
    # that is the whole convention. A legacy layout is MIGRATED, not blessed.
    moving = not is_nested(root) and not args.in_place
    target = root / NOTES_DIRS[0] if moving else root
    if moving:
        print(f"── kb adopt: {root} → {target} ──")
        print(f"  move into {target.name}/: {OVERVIEW} + "
              f"{len(load_notes(root)) + (len(renames) if not args.apply else 0)} "
              "numbered file(s)")
        print("  (only the numbered notes and the index move; *.bak.*, dotfiles "
              "and everything else stay where they are)")
        if not args.apply:
            print("\npreview only — re-run with --apply to write")
            return 0
        target.mkdir(exist_ok=True)
        for path in [root / OVERVIEW] + [n.path for n in load_notes(root)]:
            shutil.move(str(path), str(target / path.name))
            print(f"  moved {path.name}")
        root = target

    overview = root / OVERVIEW
    text = overview.read_text(encoding="utf-8")
    notes = load_notes(root)

    harvested = harvest_table(text)
    planned = [n for n in notes if not n.has_fm]
    titles = {n.name: harvested.get(n.name) or n.title for n in planned}
    if not moving:
        print(f"── kb adopt: {root} ──")
    for n in planned:
        src = "from table" if harvested.get(n.name) else "from H1"
        print(f"  front matter -> {n.name}   kind={n.kind}  "
              f"title={titles[n.name]!r} ({src})")
    if not planned:
        print("  front matter: nothing to add")

    has_block = replace_block(text, "") is not None
    table_start = None
    if not has_block:
        lines = text.split("\n")
        for i, line in enumerate(lines):
            if line.lstrip().startswith("|"):
                table_start = i
                break
        where = (f"replacing the existing table at line {table_start + 1}"
                 if table_start is not None else "appended at the end")
        print(f"  managed block  -> {OVERVIEW} ({where})")
    else:
        print("  managed block: already present")

    if not args.apply:
        print("\npreview only — re-run with --apply to write "
              "(a .bak is made for every file touched)")
        return 0

    # Built by hand, not with_suffix(): a multi-dot suffix is not a valid
    # argument for it, and the name may already contain dots.
    stamp = date.today().strftime("%Y%m%d")
    made = []          # backups this run created, to verify and drop below
    for n in planned:
        body = n.path.read_text(encoding="utf-8")
        bak = n.path.parent / f"{n.name}.bak.{stamp}"
        bak.write_text(body, encoding="utf-8")
        fm = [FM_FENCE, f"title: {titles[n.name]}", f"kind: {n.kind}",
              f"updated: {n.updated}", FM_FENCE, ""]
        n.path.write_text("\n".join(fm) + body, encoding="utf-8")
        made.append((bak, n.path, body))
        print(f"  wrote front matter: {n.name}")

    if not has_block:
        obak = overview.parent / f"{OVERVIEW}.bak.{stamp}"
        obak.write_text(text, encoding="utf-8")
        lines = text.split("\n")
        if table_start is not None:
            end = table_start
            while end < len(lines) and lines[end].lstrip().startswith("|"):
                end += 1
            lines[table_start:end] = [MARK_BEGIN + f" lang={LANG}" + S("block_note"), MARK_END]
        else:
            lines += ["", S("index_heading"), "", MARK_BEGIN + f" lang={LANG}" + S("block_note"), MARK_END]
        overview.write_text("\n".join(lines), encoding="utf-8")
        made.append((obak, overview, None))
        print(f"  inserted managed block: {OVERVIEW}")

    # A backup earns its keep only until the write it guards is verified. Kept
    # past that it is litter that `check` then nags about for years, and the
    # nagging is what teaches people to ignore `check`. So: read the file back,
    # confirm the original body survived intact, drop the copy. Anything that
    # does not match is left alone and named -- that is the case backups exist
    # for, and it is the one nobody should clean up automatically.
    if made and not args.keep_backups:
        dropped, kept = 0, []
        for bak, live, body in made:
            now = live.read_text(encoding="utf-8")
            intact = (body is not None and now.endswith(body)) or \
                     (body is None and MARK_BEGIN in now)
            if intact:
                bak.unlink()
                dropped += 1
            else:
                kept.append(bak.name)
        if dropped:
            print(f"  verified and removed {dropped} backup(s)")
        for name in kept:
            print(f"  KEPT {name} — the file changed in more than front matter")

    # The migration moved the overview into kb/, so the directory named on the
    # command line no longer holds one. `sync` resolves the root from scratch --
    # point it at where the notes ended up, or it fails on a migration that just
    # succeeded and leaves the index stale.
    args.dir = str(root)
    # Only scaffolding an overview registers a directory, and adopt moves one
    # that already exists -- so a retrofitted kb stayed invisible to `kb list`.
    register(root)
    args.no_sync = False
    return cmd_sync(args)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="kb",
        description="Work-notes directory with a generated index.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="kinds:\n" + "\n".join(f"  {k:<10} {v}" for k, v in KINDS.items()),
    )
    ap.add_argument("--dir", help="kb root (default: ./kb, else . if it has "
                                  f"{OVERVIEW})")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def with_dir(p):
        """`--dir` after the subcommand as well as before it.

        Both orders read naturally and one of them used to exit 2 with
        `unrecognized arguments` -- including the order this tool's own error
        message recommends (`kb init --dir <path>`). SUPPRESS is what keeps the
        two from fighting: without it the subparser would set `dir` to None and
        overwrite a value given before the subcommand.
        """
        p.add_argument("--dir", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        return p

    p = with_dir(sub.add_parser("init", help="scaffold a new kb directory"))
    p.add_argument("--title", help="heading for the overview")
    p.set_defaults(fn=cmd_init)

    p = with_dir(sub.add_parser("add", help="create the next numbered note"))
    p.add_argument("slug", help="short kebab-case name, no number")
    p.add_argument("--kind", default="reference", choices=list(KINDS))
    p.add_argument("--title", help="what the reader finds here (index row text)")
    p.add_argument("--supersedes", help="file this one replaces")
    p.add_argument("--body-file", metavar="PATH",
                   help="note body, or - for stdin; skips the section skeleton")
    p.add_argument("--no-sync", action="store_true", help="skip the index rewrite")
    p.set_defaults(fn=cmd_add)

    p = with_dir(sub.add_parser("sync", help="regenerate the index table"))
    p.set_defaults(fn=cmd_sync, no_sync=False)

    p = with_dir(sub.add_parser("check", help="report drift, exit 3 if any"))
    p.set_defaults(fn=cmd_check)

    p = with_dir(sub.add_parser("brief", help="the notes verbatim: overview + current snapshot, no summarising"))
    p.set_defaults(fn=cmd_brief)

    p = with_dir(sub.add_parser("status", help="human summary"))
    p.set_defaults(fn=cmd_status)

    p = with_dir(sub.add_parser("list", help="every known kb: where it lives, what is inside"))
    p.add_argument("--scan", metavar="DIR", help="pick up existing kbs under DIR")
    p.add_argument("--prune", action="store_true", help="drop dead entries")
    p.set_defaults(fn=cmd_list)

    p = with_dir(sub.add_parser("streams", help="which directories this session touched"))
    p.add_argument("--sessions", type=int, default=5,
                   help="recent sessions per source to read (default 5). Only "
                        "sessions bound to the current directory are ever read")
    p.add_argument("--top", type=int, default=12, help="directories to show")
    p.set_defaults(fn=cmd_streams)

    p = with_dir(sub.add_parser("verify", help="advisory: paths that vanished, notes gone stale"))
    p.set_defaults(fn=cmd_verify)

    p = with_dir(sub.add_parser("hook", help="git pre-commit that blocks on a found credential"))
    p.add_argument("--install", action="store_true", help="write the hook")
    p.add_argument("--dry-run", action="store_true", help="print what would happen")
    p.set_defaults(fn=cmd_hook)

    p = with_dir(sub.add_parser(
        "route", help=f"write {ROUTE_FILE} at the project root so agents find the notes"))
    p.set_defaults(fn=cmd_route)

    p = with_dir(sub.add_parser(
        "local", help="keep the notes out of git (.git/info/exclude)"))
    p.add_argument("--dry-run", action="store_true", help="print what would happen")
    p.set_defaults(fn=cmd_local)

    p = with_dir(sub.add_parser("outline", help="section map with weights — where the seams are"))
    p.add_argument("file", nargs="?", help="file; omitted = every file over "
                                           f"{SOFT_LINES} lines")
    p.set_defaults(fn=cmd_outline)

    p = with_dir(sub.add_parser("adopt", help="retrofit an existing hand-made directory"))
    p.add_argument("--keep-backups", action="store_true",
                   help="do not remove the *.bak.* copies after verifying them")
    p.add_argument("--apply", action="store_true", help="write (default: preview)")
    p.add_argument("--in-place", action="store_true",
                   help="do NOT move the notes into kb/ (they stay loose in the "
                        "current directory — against the convention, use only "
                        "when something outside links them by path)")
    p.set_defaults(fn=cmd_adopt, no_sync=False)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
