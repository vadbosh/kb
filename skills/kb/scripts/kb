#!/usr/bin/env python3
"""kb — keep a work-notes directory and its index in sync.

The pattern this automates: one `00-overview.md` acting as a map of content,
plus numbered topic files around it. Written by hand it rots in three ways —
the index drifts from the files, links point at deleted files, and the "current
snapshot" rule lives only as prose nobody checks. The cost shows up as a pile of
`00-overview.md.bak.*` next to a real directory.

Split of labour, deliberate:
    MECHANICAL (here)  numbering, the index table, drift detection, which state
                       snapshot is the newest one
    JUDGEMENT (agent)  whether new knowledge is a new file or an existing one,
                       what the one-line description says, when to split a file

So the index table lives inside a MANAGED BLOCK and is regenerated from each
file's front matter. Prose outside the block is never touched — that is the
whole point: the human keeps writing, the table stops rotting.

The subcommands are listed by `kb --help`, and only there: a second copy here
went half stale within a month, naming six of the fourteen.

Layouts, both supported:
    ./kb/00-overview.md     normal: notes live in a subdirectory of a project
    ./00-overview.md        flat: the directory IS the work stream (scratch dirs)

Supported to read and to write, never started by accident: a stream directory
exists before its notes do, and kb does not scaffold into a directory it did not
make. So a flat kb comes from `adopt --in-place` on notes already sitting there,
or from KB_ALLOW_EXISTING=1 on a directory meant to hold them.

Exit codes:
    0 — done / clean
    1 — error (a refusal counts: `route` on a file it did not write, `streams`
        with no transcript to read)
    3 — drift found (`kb check` only)
    4 — a credential is in a note (`kb check` only) — reported, never edited
"""
import argparse
import io
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from datetime import date
from pathlib import Path

OVERVIEW = "00-overview.md"

# Two names, searched in this order; the first is what gets created. The second
# exists because `kb/` is an ordinary directory name and a project may already
# have one -- source, a placeholder, anything. kb does not write into a
# directory it did not make, so the notes need somewhere else to go, and a name
# nobody searches for is not an alternative: every later command would need
# `--dir` and nothing remembers it between sessions.
NOTES_DIRS = ("kb", ".kb")


def absolute(root: Path) -> Path:
    """Resolve without requiring the path to exist.

    Everything derived from a parent breaks on a relative one: `Path(".kb")`
    has `Path(".")` for a parent and the empty string for its name, which is
    how an overview came out titled `# ` — the project name it should carry was
    that empty string. `--dir .kb` is the ordinary way to type it.
    """
    try:
        return root.resolve()
    except OSError:
        return Path(os.path.abspath(root))


def search_bases(cwd: Path):
    """Directories to look in, nearest first — cwd, then up, the way git looks.

    Work happens in a subdirectory of a project far more often than in its root,
    and until this existed every command run from one reported that the project
    had no notes at all. A session standing in `.git` found nothing either,
    which is how it was noticed.

    Bounded, because "walk to the root" would adopt a stranger's notes. The
    repository root ends the walk when there is one: outside it is another
    project. Without one the walk stops before `$HOME`, where a kb is refused
    anyway — notes sitting directly in a home directory have nothing to be about.
    """
    home = Path.home().resolve()
    git = find_git_dir(cwd)
    stop = git.parent.resolve() if git else None
    d = cwd
    while True:
        if d != home:
            yield d
        if d == stop or d == home or d.parent == d:
            return
        d = d.parent


def is_nested(root: Path) -> bool:
    """Notes in a directory of their own, with the work stream around them.

    The other layout is flat -- the directory IS the stream. Written out ten
    times as `root.name == "kb"` before the second name existed; one of those
    ten left unchanged would compute the project as the notes directory itself
    and send the entry point, the exclude rule and the work scan into it.
    """
    return root.name in NOTES_DIRS


def project_of(root: Path) -> Path:
    """The work stream this kb belongs to. The kb itself, when the layout is flat."""
    return root.parent if is_nested(root) else root
MARK_BEGIN = "<!-- kb:begin"          # prefix only; the rest of the line is a note
MARK_END = "<!-- kb:end -->"

# Everything the tool WRITES INTO the notes, in one place. Diagnostics stay in
# English — they are the tool talking. This is different: it lands inside
# documents a human reads, so it has to match the language they are written in.
# KB_LANG picks; adding a language means adding a key, nothing else changes.
# The language a kb is written in belongs to the kb, not to the machine. It is
# recorded in the `kb:begin` marker of the overview when the directory is
# scaffolded, and every later render reads it back — so two streams in two
# languages live side by side, and a stream keeps its language when it is
# cloned onto a machine set up differently.
#
# KB_LANG still decides, but only for a kb that has no language yet. Setting it
# against a kb that does is a request to switch, and switching is not a setting:
# the titles, the prose outside the markers and the entry point are all written
# by hand and none of them change by themselves. `check` says so rather than
# silently producing a half-translated file.
LANG_ENV = os.environ.get("KB_LANG")
# The language a kb gets when nothing says otherwise — no KB_LANG, no mark in
# the overview.
LANG_DEFAULT = "ru"
# What renders when the language asked for has no entry in STRINGS. English,
# not the default above: a reader who set KB_LANG=de reads more languages than
# one, and English is the likelier of the two to be among them. Russian was the
# fallback until 2026-09-19 and it was the wrong one — it answered "unknown
# language" with the language of this machine rather than the language of the
# wider audience.
LANG_FALLBACK = "en"
LANG_RE = re.compile(r"kb:begin\s+lang=([a-z]{2})\b")
LANG = LANG_ENV or LANG_DEFAULT
STRINGS = {
